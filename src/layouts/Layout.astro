---
// The document shell for every page: head metadata (canonical, hreflang, Open Graph), self-hosted fonts and
// the notebook stylesheet. Kalam is the hand, Courier Prime the type; fallbacks live in the CSS tokens.
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '@fontsource/courier-prime/400-italic.css';
import '../styles/notebook.css';
import { copy, shared } from '../data/copy.mjs';

interface Props { lang?: 'en' | 'es'; path?: string; index?: boolean }
const { lang = 'en', path, index = true } = Astro.props;
const t = copy[lang];
const site = shared.site;
const home = { en: '/', es: '/es/' };
const canonical = site + (path ?? home[lang]);
const other = lang === 'en' ? 'es' : 'en';
// only the English first page picks a language for the visitor
const redirect = lang === 'en' && index && !path;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Javier Ponz',
  url: site + '/',
  email: shared.email,
  sameAs: [shared.github, shared.x, shared.linkedin]
};
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  {redirect && <script is:inline>
    /* nb-lang: a first visit to / from a browser whose first language is Spanish goes to /es/ before the first paint;
       a choice made with the EN / ES tabs (stored by notebook.js) always wins. /es/ never redirects. */
    try { var c = null; try { c = localStorage.getItem('nb-lang'); } catch (e) {}
      var l = (navigator.languages && navigator.languages[0]) || navigator.language || '';
      if (c === 'es' || (c !== 'en' && /^es(-|_|$)/i.test(l))) location.replace('/es/' + location.search + location.hash);
    } catch (e) {}
  </script>}
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#eceee8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121922" media="(prefers-color-scheme: dark)" />
  {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
  {index && <link rel="alternate" hreflang="en" href={site + home.en} />}
  {index && <link rel="alternate" hreflang="es" href={site + home.es} />}
  {index && <link rel="alternate" hreflang="x-default" href={site + home.en} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:locale:alternate" content={copy[other].ogLocale} />
  <meta property="og:image" content={site + '/og.jpg'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={t.meta.title} />
  <meta name="twitter:description" content={t.meta.description} />
  <meta name="twitter:image" content={site + '/og.jpg'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="me" href={shared.github} />
  <link rel="me" href={shared.x} />
  <link rel="me" href={shared.linkedin} />
  {index && <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />}
  <script is:inline>
    /* The theme chosen with the corner fold lasts for the session; restore it before the first paint. */
    try { var s = sessionStorage.getItem('nb-theme'); if (s === 'dark' || s === 'light') document.documentElement.setAttribute('data-theme', s); } catch (e) {}
  </script>
</head>
<body>
  <slot />
</body>
</html>
