---
interface Props { title: string; description?: string; dark?: boolean }
const { title, description = 'Javier Ponz — technology, service, agents and field notes.', dark = false } = Astro.props;
const canonical = `https://javierponz.technoir.cloud${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en" class={dark ? 'dark' : ''}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://javierponz.technoir.cloud/og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://javierponz.technoir.cloud/og.jpg" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header"><div class="shell nav">
    <a class="brand" href="/">JAVIER PONZ <span>/ FIELD NOTES</span></a>
    <nav aria-label="Primary"><a href="/about">About</a><a href="/cv">CV</a><a href="/workbench">Workbench</a><a href="/memento-mori">Case study</a><a href="/thesis">Thesis</a><a href="/now">Now</a><a href="/contact">Contact</a></nav>
  </div></header>
  <main id="main" class="shell"><slot /></main>
  <footer class="shell footer"><span>JAVIER PONZ · ABERDEEN / MADRID</span><span><a href="mailto:nerion89@gmail.com">Email</a> · <a href="https://github.com/ponzgpt">GitHub</a> · <a href="https://www.linkedin.com/in/javierponz">LinkedIn</a> · <a href="https://nousresearch.technoir.cloud/">Nous application</a></span></footer>
</body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap');
:root{--paper:#f7f7f3;--ink:#090909;--muted:#555;--line:#151515;--wash:#e9e9e3;--max:1120px}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:'Courier Prime','Courier New',monospace;scroll-behavior:smooth}body{margin:0;line-height:1.55}a{color:inherit}a:hover{background:var(--ink);color:var(--paper)}.shell{width:min(calc(100% - 44px),var(--max));margin:auto}.site-header{border-bottom:1px solid var(--line)}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{font-weight:700;letter-spacing:.02em;text-decoration:none}.brand span{font-size:11px;color:var(--muted);font-weight:400}.nav nav{display:flex;gap:20px;flex-wrap:wrap}.nav nav a{font-size:12px;text-decoration:none;color:var(--muted)}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:var(--ink);color:var(--paper);padding:8px;z-index:4}.kicker,.label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.hero{padding:100px 0 90px;max-width:900px}.hero h1{font-size:clamp(48px,8vw,96px);line-height:.94;letter-spacing:-.07em;margin:20px 0 28px;font-weight:700}.serif{font:inherit;font-style:italic;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:6px}.lede{font-size:20px;max-width:700px}.grid{display:grid;grid-template-columns:190px 1fr;gap:60px;border-top:1px solid var(--line);padding:70px 0}.grid h2{font-size:32px;line-height:1.05;letter-spacing:-.05em;margin:0 0 25px}.copy{max-width:750px;font-size:17px}.copy p{margin:0 0 18px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.card{background:var(--paper);padding:24px;min-height:180px}a.card,a.row{text-decoration:none}a.card:hover,a.row:hover{background:var(--ink);color:var(--paper)}a.card:hover .meta,a.card:hover p,a.row:hover time,a.row:hover p{color:var(--paper)}.card h3{font-size:21px;line-height:1.1;margin:22px 0 8px}.card p{font-size:14px;color:var(--muted);margin:0}.meta{font-size:11px;color:var(--muted);text-transform:uppercase}.rows{border-top:1px solid var(--ink)}.row{display:grid;grid-template-columns:150px 1fr 90px;gap:20px;padding:18px 0;border-bottom:1px solid var(--line);font-size:14px}.row time,.row span:last-child{color:var(--muted)}.notice{border-left:3px solid var(--ink);background:var(--wash);padding:25px;font-size:20px;max-width:750px}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.tag{font-size:12px;border:1px solid var(--line);padding:4px 10px;color:var(--muted)}.skillgroup{margin:0 0 28px}.skillgroup h3{font-size:15px;letter-spacing:.06em;text-transform:uppercase;margin:0}.prose{max-width:750px;font-size:17px}.prose h2{font-size:28px;line-height:1.1;letter-spacing:-.04em;margin:38px 0 16px}.prose h3{font-size:18px;margin:28px 0 10px}.prose p,.prose li{margin:0 0 16px}.prose ul{padding-left:20px}.prose code{background:var(--wash);padding:2px 6px;font-size:14px}.shot{margin:0 0 34px}.shot img{width:100%;height:auto;display:block;border:1px solid var(--line)}.shot a:hover{background:none}.shot figcaption{font-size:12px;color:var(--muted);margin-top:8px;text-transform:uppercase;letter-spacing:.06em}.footer{border-top:1px solid var(--line);padding:25px 0 40px;color:var(--muted);display:flex;justify-content:space-between;font-size:12px}.footer a{color:var(--ink)}.dark{--paper:#090909;--ink:#f7f7f3;--muted:#aaa;--line:#f7f7f3;--wash:#181818}.dark .site-header,.dark .footer{border-color:var(--line)}.dark a:hover{background:var(--paper);color:var(--ink)}.dark .card{background:var(--paper);color:var(--ink)}.dark .notice{background:var(--wash)}
@media(max-width:760px){.nav{align-items:flex-start;flex-direction:column;padding:20px 0}.nav nav{gap:12px}.hero{padding:65px 0}.grid{display:block;padding:55px 0}.label{margin-bottom:20px;display:block}.cards{grid-template-columns:1fr}.row{grid-template-columns:90px 1fr}.row span:last-child{display:none}.footer{display:block}.footer span{display:block;margin-bottom:8px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
