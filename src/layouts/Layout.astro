---
interface Props { title: string; description?: string; dark?: boolean }
const { title, description = 'Javier Ponz — technology, service, agents and field notes.', dark = false } = Astro.props;
const canonical = `https://javierponz.technoir.cloud${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en" class={dark ? 'dark' : ''}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header"><div class="shell nav">
    <a class="brand" href="/">JAVIER PONZ <span>/ FIELD NOTES</span></a>
    <nav aria-label="Primary"><a href="/about">About</a><a href="/timeline">Timeline</a><a href="/workbench">Workbench</a><a href="/now">Now</a><a href="/nous-application">Nous</a></nav>
  </div></header>
  <main id="main" class="shell"><slot /></main>
  <footer class="shell footer"><span>JAVIER PONZ · ABERDEEN / MADRID</span><span><a href="mailto:nerion89@gmail.com">Email</a> · <a href="https://github.com/ponzgpt">GitHub</a> · <a href="https://www.linkedin.com/in/javierponz">LinkedIn</a></span></footer>
</body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap');
:root{--paper:#f3f0e8;--ink:#202622;--muted:#687169;--line:#c9c9bd;--green:#587463;--orange:#c66a42;--panel:#e9e6db;--max:1120px}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:Manrope,system-ui,sans-serif;scroll-behavior:smooth}body{margin:0;line-height:1.6}a{color:inherit}a:hover{color:var(--orange)}.shell{width:min(calc(100% - 44px),var(--max));margin:auto}.site-header{border-bottom:1px solid var(--line)}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{font-weight:800;letter-spacing:-.04em;text-decoration:none}.brand span{font:11px 'DM Mono',monospace;color:var(--muted);font-weight:400}.nav nav{display:flex;gap:20px;flex-wrap:wrap}.nav nav a{font:12px 'DM Mono',monospace;text-decoration:none;color:var(--muted)}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:var(--ink);color:white;padding:8px;z-index:4}.kicker,.label{font:11px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--green)}.hero{padding:100px 0 90px;max-width:900px}.hero h1{font-size:clamp(48px,8vw,96px);line-height:.94;letter-spacing:-.09em;margin:20px 0 28px}.serif{font:400 1.08em Newsreader,serif;color:var(--orange);letter-spacing:-.06em}.lede{font-size:20px;color:#3f4941;max-width:700px}.grid{display:grid;grid-template-columns:190px 1fr;gap:60px;border-top:1px solid var(--line);padding:70px 0}.grid h2{font-size:32px;line-height:1.05;letter-spacing:-.06em;margin:0 0 25px}.copy{max-width:750px;font-size:17px}.copy p{margin:0 0 18px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.card{background:var(--paper);padding:24px;min-height:180px}.card h3{font-size:21px;line-height:1.1;margin:22px 0 8px}.card p{font-size:14px;color:var(--muted);margin:0}.meta{font:11px 'DM Mono',monospace;color:var(--orange);text-transform:uppercase}.rows{border-top:1px solid var(--ink)}.row{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--line)}.row time{font:12px 'DM Mono',monospace;color:var(--muted)}.row h3{margin:0 0 5px;font-size:20px}.row p{margin:0;color:var(--muted)}.tags{display:flex;gap:8px;flex-wrap:wrap}.tag{border:1px solid var(--line);border-radius:99px;padding:6px 10px;font:12px 'DM Mono',monospace}.notice{border-left:3px solid var(--orange);background:var(--panel);padding:20px}.footer{border-top:1px solid var(--line);padding:26px 0 40px;color:var(--muted);font:11px 'DM Mono',monospace;display:flex;justify-content:space-between;gap:15px}.dark{--paper:#0b0c0c;--ink:#ededed;--muted:#9a9d99;--line:#303331;--panel:#151817}.dark body{background:var(--paper)}.dark .lede,.dark .copy{color:#d0d4d0}.dark .card{background:#111312}
@media(max-width:760px){.nav{align-items:flex-start;flex-direction:column;padding:20px 0}.nav nav{gap:12px}.hero{padding:65px 0}.grid{display:block;padding:55px 0}.label{margin-bottom:20px;display:block}.cards{grid-template-columns:1fr}.row{grid-template-columns:90px 1fr}.footer{display:block}.footer span{display:block;margin-bottom:8px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
