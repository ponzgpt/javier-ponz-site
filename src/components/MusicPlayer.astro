---
// A fixed music control, bottom-left — squared off to match the terminal
// window's own chrome (same border, radius and background as .win), not a
// pill. No Audio element or AudioContext exists until the first click —
// verified that browsers zero out an AnalyserNode fed by a natively muted
// (or volume=0) element, which is the only way to autoplay without a
// gesture, so real analysed audio can't play silently pre-click. The bars
// idle-animate a fake, randomised pattern instead until then: an honest
// "there's sound here" invitation, not a trick — no audio loads or plays
// a single sample before the click. A small CC0 playlist shuffles on load
// and advances on `ended` once it does — no single track loops forever.
import { ui } from '../data/ui.mjs';

const { lang = 'en' } = Astro.props;
const t = ui[lang];
---
<div class="music-player">
  <button type="button" id="musicToggle" class="music-toggle" aria-pressed="false"
          aria-label={t.musicPlay} data-play-label={t.musicPlay} data-mute-label={t.musicMute}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path id="musicIconPlay" d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" />
      <g id="musicIconPause" style="display:none">
        <rect x="6.5" y="5.5" width="4" height="13" rx="1" fill="currentColor" />
        <rect x="14" y="5.5" width="4" height="13" rx="1" fill="currentColor" />
      </g>
    </svg>
  </button>
  <canvas id="musicEq" width="132" height="32" aria-hidden="true"></canvas>
  <div class="music-title-wrap" id="musicTitleWrap">
    <span class="music-title" id="musicTitle">{t.musicTitle}</span>
  </div>
  <input type="range" id="musicVolume" class="music-volume" min="0" max="100" value="55" aria-label={t.musicVolume} />
</div>

<script is:inline>
  (function () {
    var player = document.querySelector('.music-player');
    var btn = document.getElementById('musicToggle');
    var eq = document.getElementById('musicEq');
    var volumeSlider = document.getElementById('musicVolume');
    var iconPlay = document.getElementById('musicIconPlay');
    var iconPause = document.getElementById('musicIconPause');
    var titleWrap = document.getElementById('musicTitleWrap');
    var titleEl = document.getElementById('musicTitle');
    if (!player || !btn || !eq || !window.AudioContext) return;
    var ctx2d = eq.getContext('2d');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Classic VU-meter colours — deliberately fixed, not skin tokens: each
    // LED segment is coloured by its own position in the stack (bottom
    // green, mid yellow, top red), same on every skin, like a real meter.
    var GREEN = '#4ade80', YELLOW = '#facc15', RED = '#f87171', DIM = 'rgba(255,255,255,.08)';
    var SEGMENTS = 8, BARS = 12;

    // A few similarly-styled CC0 tracks (nova head, Suno-generated) rather
    // than one loop forever — shuffled on load, next one plays on `ended`.
    var TRACKS = [
      { file: '/audio/crown-of-the-horizon.mp3', title: 'Crown of the Horizon' },
      { file: '/audio/neon-eyes.mp3', title: 'Neon Eyes' },
      { file: '/audio/electric-bloom.mp3', title: 'Electric Bloom' },
      { file: '/audio/digital-dream.mp3', title: 'Digital Dream' }
    ];
    function shuffle(arr) {
      var a = arr.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
      }
      return a;
    }
    var order = shuffle(TRACKS.map(function (_, i) { return i; }));
    var pos = 0, current = TRACKS[order[0]];

    var audio = null, actx = null, analyser = null, gain = null, freq = null, raf = null, playing = false;
    var volume = (parseInt(volumeSlider.value, 10) || 55) / 100;

    function setTitle(title) {
      titleEl.textContent = title + '   •   ' + title;
      titleWrap.classList.remove('marquee');
      requestAnimationFrame(function () {
        var single = titleEl.scrollWidth / 2;
        if (single > titleWrap.clientWidth) titleWrap.classList.add('marquee');
      });
      btn.title = 'nova head — "' + title + '" (CC0)';
    }

    function build() {
      if (audio) return;
      audio = new Audio();
      audio.preload = 'none';
      audio.addEventListener('ended', nextTrack);
      actx = new AudioContext();
      analyser = actx.createAnalyser();
      analyser.fftSize = 64;
      freq = new Uint8Array(analyser.frequencyBinCount);
      gain = actx.createGain();
      gain.gain.value = 0;
      actx.createMediaElementSource(audio).connect(analyser);
      analyser.connect(gain);
      gain.connect(actx.destination);
      audio.src = current.file;
      setTitle(current.title);
    }

    function nextTrack() {
      pos++;
      if (pos >= order.length) { order = shuffle(TRACKS.map(function (_, i) { return i; })); pos = 0; }
      current = TRACKS[order[pos]];
      audio.src = current.file;
      setTitle(current.title);
      if (playing) audio.play().catch(function () {});
    }

    function rampTo(v) {
      var now = actx.currentTime;
      gain.gain.cancelScheduledValues(now);
      gain.gain.setValueAtTime(gain.gain.value, now);
      gain.gain.linearRampToValueAtTime(v, now + 0.4);
    }

    // Shared renderer: both the real (analyser-driven) and idle (fake,
    // randomised) states draw the same LED ladder from a 0..1 array —
    // browsers zero out the analyser when the source element is natively
    // muted or volume=0 (verified: that's what autoplay-without-a-click
    // would require), so there is no way to autoplay real, analysed audio
    // silently. The idle animation is an honest simulation instead: no
    // audio ever loads or plays until the click, it just LOOKS alive.
    function renderSegments(values) {
      var w = eq.width, h = eq.height, gap = 3, bw = (w - gap * (BARS - 1)) / BARS;
      var segGap = 2, segH = (h - segGap * (SEGMENTS - 1)) / SEGMENTS;
      ctx2d.clearRect(0, 0, w, h);
      for (var i = 0; i < BARS; i++) {
        var lit = Math.max(1, Math.round(values[i] * SEGMENTS));
        for (var s = 0; s < SEGMENTS; s++) {
          var y = h - (s + 1) * (segH + segGap) + segGap;
          var frac = s / SEGMENTS;
          ctx2d.fillStyle = s < lit ? (frac < 0.5 ? GREEN : frac < 0.8 ? YELLOW : RED) : DIM;
          ctx2d.fillRect(i * (bw + gap), y, bw, segH);
        }
      }
    }
    function drawBars() {
      analyser.getByteFrequencyData(freq);
      var values = [];
      for (var i = 0; i < BARS; i++) values.push(freq[Math.floor((i * freq.length) / BARS)] / 255);
      renderSegments(values);
      raf = requestAnimationFrame(drawBars);
    }
    var idleTimer = null;
    var idleVals = new Array(BARS).fill(0).map(function () { return 0.1 + Math.random() * 0.15; });
    function drawIdleAnimated() {
      for (var i = 0; i < BARS; i++) {
        idleVals[i] += (Math.random() - 0.5) * 0.22;
        idleVals[i] = Math.max(0.06, Math.min(0.55, idleVals[i]));
      }
      renderSegments(idleVals);
      idleTimer = setTimeout(drawIdleAnimated, 170);
    }
    function stopIdle() {
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    }
    function drawFlat() {
      renderSegments(new Array(BARS).fill(0));
    }

    function play() {
      build();
      if (actx.state !== 'running') actx.resume();
      audio.play().catch(function () {});
      rampTo(volume);
      playing = true;
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', btn.dataset.muteLabel);
      player.classList.add('playing');
      iconPlay.style.display = 'none'; iconPause.style.display = '';
      stopIdle();
      if (!reduce && !raf) drawBars();
    }
    function mute() {
      playing = false;
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-label', btn.dataset.playLabel);
      player.classList.remove('playing');
      iconPlay.style.display = ''; iconPause.style.display = 'none';
      if (gain) rampTo(0);
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      if (reduce) drawFlat(); else if (!idleTimer) drawIdleAnimated();
    }
    if (reduce) drawFlat(); else drawIdleAnimated();
    btn.addEventListener('click', function () { playing ? mute() : play(); });
    volumeSlider.addEventListener('input', function () {
      volume = volumeSlider.value / 100;
      if (playing && gain) gain.gain.value = volume;
    });
    document.addEventListener('visibilitychange', function () {
      if (!audio) return;
      if (document.hidden && playing) audio.pause();
      else if (!document.hidden && playing) audio.play().catch(function () {});
    });
  })();
</script>

<style is:global>
  .music-player{
    position:fixed;left:18px;bottom:18px;z-index:15;
    display:flex;align-items:center;gap:10px;
    height:52px;padding:0 14px 0 8px;border-radius:10px;
    border:2px solid var(--accent2);
    background:color-mix(in srgb, var(--bg), #000 22%);
  }
  .music-toggle{
    display:flex;align-items:center;justify-content:center;flex:none;
    width:34px;height:34px;border-radius:6px;
    background:var(--accent2);color:var(--bg);border:0;cursor:pointer;
  }
  .music-toggle svg{width:18px;height:18px}
  .music-player canvas{display:block;flex:none}
  .music-title-wrap{width:110px;flex:none;overflow:hidden;position:relative}
  .music-title{
    display:inline-block;white-space:nowrap;
    font-family:var(--font-display);font-size:12px;color:var(--fg);
  }
  .music-title-wrap.marquee .music-title{animation:music-marquee 9s linear infinite}
  @keyframes music-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){.music-title-wrap.marquee .music-title{animation:none}}
  .music-volume{width:60px;flex:none;accent-color:var(--accent2);cursor:pointer}
  @media(max-width:640px){
    .music-player{left:10px;bottom:10px;padding-right:10px;gap:7px}
    .music-title-wrap,.music-volume{display:none}
  }
</style>
