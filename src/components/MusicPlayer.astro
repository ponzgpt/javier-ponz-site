---
// A small fixed music control, bottom-left — same shape as omarchy.org's
// own: nothing loads or plays until the first click (no Audio element, no
// AudioContext), so there's no autoplay-with-sound to fight the browser
// over. Click starts it muted→playing with a gain ramp; click again mutes.
// A real-time AnalyserNode drives the tiny EQ bars while it's sounding.
import { ui } from '../data/ui.mjs';

const { lang = 'en' } = Astro.props;
const t = ui[lang];
---
<div class="music-player">
  <button type="button" id="musicToggle" class="music-btn" aria-pressed="false"
          aria-label={t.musicPlay} title={t.musicCredit}
          data-play-label={t.musicPlay} data-mute-label={t.musicMute}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 10v4h3l4 4V6l-4 4H4Z" fill="currentColor" />
      <path d="M14.5 9.5a4 4 0 010 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M17 7a7 7 0 010 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <canvas id="musicEq" width="36" height="16" aria-hidden="true"></canvas>
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('musicToggle');
    var eq = document.getElementById('musicEq');
    if (!btn || !eq || !window.AudioContext) return;
    var ctx2d = eq.getContext('2d');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var barColor = getComputedStyle(document.documentElement).getPropertyValue('--accent2').trim() || '#9ece6a';

    var audio = null, actx = null, analyser = null, gain = null, freq = null, raf = null, playing = false;

    function build() {
      if (audio) return;
      audio = new Audio('/audio/crown-of-the-horizon.mp3');
      audio.loop = true;
      audio.preload = 'none';
      actx = new AudioContext();
      analyser = actx.createAnalyser();
      analyser.fftSize = 64;
      freq = new Uint8Array(analyser.frequencyBinCount);
      gain = actx.createGain();
      gain.gain.value = 0;
      actx.createMediaElementSource(audio).connect(analyser);
      analyser.connect(gain);
      gain.connect(actx.destination);
    }

    function rampTo(v) {
      var now = actx.currentTime;
      gain.gain.cancelScheduledValues(now);
      gain.gain.setValueAtTime(gain.gain.value, now);
      gain.gain.linearRampToValueAtTime(v, now + 0.4);
    }

    function drawBars() {
      analyser.getByteFrequencyData(freq);
      var w = eq.width, h = eq.height, n = 9, bw = w / n;
      ctx2d.clearRect(0, 0, w, h);
      ctx2d.fillStyle = barColor;
      for (var i = 0; i < n; i++) {
        var v = freq[Math.floor((i * freq.length) / n)] / 255;
        var barH = Math.max(2, v * h);
        ctx2d.fillRect(i * bw + 1, h - barH, bw - 2, barH);
      }
      raf = requestAnimationFrame(drawBars);
    }

    function play() {
      build();
      if (actx.state !== 'running') actx.resume();
      audio.play().catch(function () {});
      rampTo(0.5);
      playing = true;
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', btn.dataset.muteLabel);
      btn.classList.add('playing');
      if (!reduce && !raf) drawBars();
    }
    function mute() {
      playing = false;
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-label', btn.dataset.playLabel);
      btn.classList.remove('playing');
      if (gain) rampTo(0);
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      ctx2d.clearRect(0, 0, eq.width, eq.height);
    }
    btn.addEventListener('click', function () { playing ? mute() : play(); });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden && playing) { audio.pause(); }
      else if (!document.hidden && playing) { audio.play().catch(function () {}); }
    });
  })();
</script>

<style is:global>
  .music-player{position:fixed;left:16px;bottom:16px;z-index:15}
  .music-btn{
    display:inline-flex;align-items:center;gap:7px;
    height:36px;padding:0 12px;border-radius:18px;
    background:var(--raised);border:1px solid var(--line);color:var(--muted);
    cursor:pointer;transition:border-color .15s ease,color .15s ease;
  }
  .music-btn:hover{border-color:var(--accent2);color:var(--fg)}
  .music-btn.playing{color:var(--accent2);border-color:var(--accent2)}
  .music-btn svg{width:16px;height:16px;flex:none}
  .music-btn canvas{display:block;flex:none}
  @media(max-width:700px){.music-player{left:10px;bottom:10px}}
</style>
