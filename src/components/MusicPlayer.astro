---
// A fixed music control, bottom-left. Collapsed by default to one small
// button, so it never covers content on a phone; the button opens a panel
// with the track title, a gradient/peak-hold meter and transport + volume.
// Meter colours come from the palette tokens (--accent2 → --accent → --fg).
// While the panel is closed the meter draws nothing at all.
//
// No Audio element or AudioContext exists until the first click —
// verified that browsers zero out an AnalyserNode fed by a natively muted
// (or volume=0) element, which is the only way to autoplay without a
// gesture, so real analysed audio can't play silently pre-click. The
// meter idle-animates a fake, shaped pattern instead until then: an
// honest "there's sound here" invitation, not a trick.
//
// Six CC0 tracks (nova head, Suno-generated, sourced from Internet
// Archive — see the button's title for per-track credit) shuffle on load;
// prev/next step through that order, and `ended` advances the same way.
import { ui } from '../data/ui.mjs';

const { lang = 'en' } = Astro.props;
const t = ui[lang];
---
<div class="music-player">
  <button type="button" class="music-fab" id="musicFab" aria-expanded="false" aria-controls="musicPanel" aria-label={t.musicOpen} title={t.musicOpen}>
    <span aria-hidden="true">♪</span><span class="music-live" aria-hidden="true"></span>
  </button>
  <div class="music-panel" id="musicPanel" hidden>
  <div class="music-row music-row-title">
    <span class="music-note" aria-hidden="true">♪</span>
    <div class="music-title-wrap" id="musicTitleWrap">
      <span class="music-title" id="musicTitle">{t.musicTitle}</span>
    </div>
  </div>

  <canvas id="musicEq" width="248" height="46" class="music-eq" aria-hidden="true"></canvas>

  <div class="music-row music-row-controls">
    <div class="music-transport">
      <button type="button" id="musicPrev" class="music-btn music-btn-lg music-secondary-transport" aria-label={t.musicPrev} title={t.musicPrev}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 6.5v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <path d="M17.5 6.75v10.5L8.5 12l9-5.25Z" fill="currentColor" />
        </svg>
      </button>
      <button type="button" id="musicToggle" class="music-btn music-btn-lg" aria-pressed="false"
              aria-label={t.musicPlay} data-play-label={t.musicPlay} data-mute-label={t.musicMute}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path id="musicIconPlay" d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" />
          <g id="musicIconPause" style="display:none">
            <rect x="6.5" y="5.5" width="4" height="13" rx="1" fill="currentColor" />
            <rect x="14" y="5.5" width="4" height="13" rx="1" fill="currentColor" />
          </g>
        </svg>
      </button>
      <button type="button" id="musicNext" class="music-btn music-btn-lg music-secondary-transport" aria-label={t.musicNext} title={t.musicNext}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M16 6.5v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <path d="M6.5 6.75v10.5l9-5.25Z" fill="currentColor" />
        </svg>
      </button>
    </div>

    <span class="music-status" id="musicStatus" aria-hidden="true"></span>

    <div class="music-vol">
      <button type="button" id="musicVolDown" class="music-btn music-btn-sm" aria-label={t.musicVolDown} title={t.musicVolDown}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 10H4v4h2M6 10l6-5v14l-6-5" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" /></svg>
      </button>
      <span class="music-vol-bar" aria-hidden="true"><span class="music-vol-fill" id="musicVolFill"></span></span>
      <span class="music-vol-pct" id="musicVolPct">55%</span>
      <button type="button" id="musicVolUp" class="music-btn music-btn-sm" aria-label={t.musicVolUp} title={t.musicVolUp}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 10H4v4h2M6 10l6-5v14l-6-5" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" /><path d="M17 9a5 5 0 010 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  </div>
</div>

<script is:inline>
  (function () {
    var player = document.querySelector('.music-player');
    var btn = document.getElementById('musicToggle');
    var prevBtn = document.getElementById('musicPrev');
    var nextBtn = document.getElementById('musicNext');
    var volDownBtn = document.getElementById('musicVolDown');
    var volUpBtn = document.getElementById('musicVolUp');
    var volFill = document.getElementById('musicVolFill');
    var volPct = document.getElementById('musicVolPct');
    var statusDot = document.getElementById('musicStatus');
    var eq = document.getElementById('musicEq');
    var iconPlay = document.getElementById('musicIconPlay');
    var iconPause = document.getElementById('musicIconPause');
    var titleWrap = document.getElementById('musicTitleWrap');
    var titleEl = document.getElementById('musicTitle');
    var fab = document.getElementById('musicFab');
    var panel = document.getElementById('musicPanel');
    if (!player || !btn || !eq || !window.AudioContext) { if (player) player.hidden = true; return; }
    var ctx2d = eq.getContext('2d');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var BARS = 24;

    var cs = getComputedStyle(document.documentElement);
    var COLOR_LOW = cs.getPropertyValue('--accent2').trim() || '#a58bff';
    var COLOR_MID = cs.getPropertyValue('--accent').trim() || '#ffb23e';
    var COLOR_HIGH = cs.getPropertyValue('--fg').trim() || '#ece6da';
    function isOpen() { return !panel.hidden; }

    // CC0 (nova head, Suno-generated) — see archive.org/details/<id> per
    // track for the original upload and its licence statement.
    var TRACKS = [
      { file: '/audio/crown-of-the-horizon.mp3', title: 'Crown of the Horizon', genre: 'Synthwave' },
      { file: '/audio/neon-eyes.mp3', title: 'Neon Eyes', genre: 'Synthwave' },
      { file: '/audio/electric-bloom.mp3', title: 'Electric Bloom', genre: 'Synthwave' },
      { file: '/audio/digital-dream.mp3', title: 'Digital Dream', genre: 'Synthwave' },
      { file: '/audio/signal-void.mp3', title: 'Signal Void', genre: 'Darksynth' },
      { file: '/audio/static-crown.mp3', title: 'Static Crown', genre: 'Darksynth' }
    ];
    function shuffle(arr) {
      var a = arr.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
      }
      return a;
    }
    var order = shuffle(TRACKS.map(function (_, i) { return i; }));
    var pos = 0, current = TRACKS[order[0]];

    var audio = null, actx = null, analyser = null, gain = null, freq = null, raf = null, playing = false;
    var volume = 0.55;

    function setVolumeUi() {
      var pct = Math.round(volume * 100);
      volFill.style.width = pct + '%';
      volPct.textContent = pct + '%';
    }
    setVolumeUi();

    // Measures the *single* copy of "artist — title (genre)" first, only
    // duplicating (for the seamless -50% loop) when it would actually
    // overflow — a double-rAF wait avoids a font/layout race leaving
    // scrollWidth read too early, and a forced reflow before re-adding the
    // animation class means it reliably restarts instead of ever freezing
    // mid-scroll on a track change.
    function setTitle(track) {
      var text = 'nova head — ' + track.title + ' (' + track.genre + ')';
      titleWrap.classList.remove('marquee');
      titleEl.textContent = text;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          if (titleEl.scrollWidth > titleWrap.clientWidth) {
            titleEl.textContent = text + '     •     ' + text;
            void titleWrap.offsetWidth;
            titleWrap.classList.add('marquee');
          }
        });
      });
      btn.title = text + ' — CC0, archive.org';
    }

    function build() {
      if (audio) return;
      audio = new Audio();
      audio.preload = 'none';
      audio.addEventListener('ended', function () { step(1); });
      actx = new AudioContext();
      analyser = actx.createAnalyser();
      analyser.fftSize = 64;
      freq = new Uint8Array(analyser.frequencyBinCount);
      gain = actx.createGain();
      gain.gain.value = 0;
      actx.createMediaElementSource(audio).connect(analyser);
      analyser.connect(gain);
      gain.connect(actx.destination);
      audio.src = current.file;
      setTitle(current);
    }

    // dir: +1 next, -1 previous — both just move the shuffled pointer;
    // going past either end reshuffles rather than repeating the same order.
    function step(dir) {
      pos += dir;
      if (pos >= order.length) { order = shuffle(TRACKS.map(function (_, i) { return i; })); pos = 0; }
      if (pos < 0) { order = shuffle(TRACKS.map(function (_, i) { return i; })); pos = order.length - 1; }
      current = TRACKS[order[pos]];
      setTitle(current);
      if (!audio) return;
      audio.src = current.file;
      if (playing) audio.play().catch(function () {});
    }

    function rampTo(v) {
      var now = actx.currentTime;
      gain.gain.cancelScheduledValues(now);
      gain.gain.setValueAtTime(gain.gain.value, now);
      gain.gain.linearRampToValueAtTime(v, now + 0.4);
    }
    function setVolume(v) {
      volume = Math.max(0, Math.min(1, v));
      setVolumeUi();
      if (playing && gain) gain.gain.value = volume;
    }

    // Continuous gradient bars (green→amber→pink, bottom to top) with a
    // decaying peak-hold dash per bar — not discrete LED squares. Peaks
    // persist across idle/real so the meter never visually "resets".
    var peaks = new Array(BARS).fill(0);
    function renderMeter(values) {
      var w = eq.width, h = eq.height, gap = 2, bw = (w - gap * (BARS - 1)) / BARS;
      ctx2d.clearRect(0, 0, w, h);
      var grad = ctx2d.createLinearGradient(0, h, 0, 0);
      grad.addColorStop(0, COLOR_LOW);
      grad.addColorStop(0.65, COLOR_MID);
      grad.addColorStop(1, COLOR_HIGH);
      for (var i = 0; i < BARS; i++) {
        var v = values[i];
        peaks[i] = v >= peaks[i] ? v : Math.max(0, peaks[i] - 0.012);
        var barH = Math.max(1.5, v * h);
        ctx2d.fillStyle = grad;
        ctx2d.fillRect(i * (bw + gap), h - barH, bw, barH);
        var peakY = Math.max(1, h - peaks[i] * h);
        ctx2d.fillStyle = COLOR_HIGH;
        ctx2d.fillRect(i * (bw + gap), peakY - 1, bw, 1.4);
      }
    }
    function drawBars() {
      analyser.getByteFrequencyData(freq);
      var values = [];
      for (var i = 0; i < BARS; i++) values.push(freq[Math.floor((i * freq.length) / BARS)] / 255);
      renderMeter(values);
      raf = isOpen() ? requestAnimationFrame(drawBars) : null;
    }
    var idleTimer = null, idleT = 0;
    // A bass-heavy fake shape (taller on the left, like a real spectrum)
    // plus per-bar sine oscillation and noise — crosses into amber and
    // occasional pink on the leading bars, same as genuine playback.
    var idlePhase = new Array(BARS).fill(0).map(function () { return Math.random() * Math.PI * 2; });
    var idleBase = new Array(BARS).fill(0).map(function (_, i) { return 0.8 - (i / BARS) * 0.55; });
    function drawIdleAnimated() {
      idleT += 0.12;
      var values = idleBase.map(function (base, i) {
        var osc = Math.sin(idleT * (1.3 + i * 0.05) + idlePhase[i]) * 0.22;
        var noise = (Math.random() - 0.5) * 0.1;
        return Math.max(0.04, Math.min(0.98, base + osc + noise));
      });
      renderMeter(values);
      idleTimer = isOpen() ? setTimeout(drawIdleAnimated, 110) : null;
    }
    function stopIdle() {
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    }
    function drawFlat() {
      renderMeter(new Array(BARS).fill(0));
    }

    function play() {
      build();
      if (actx.state !== 'running') actx.resume();
      audio.play().catch(function () {});
      rampTo(volume);
      playing = true;
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', btn.dataset.muteLabel);
      player.classList.add('playing');
      fab.classList.add('playing');
      statusDot.classList.add('playing');
      iconPlay.style.display = 'none'; iconPause.style.display = '';
      stopIdle();
      if (!reduce && !raf && isOpen()) drawBars();
    }
    function mute() {
      playing = false;
      btn.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-label', btn.dataset.playLabel);
      player.classList.remove('playing');
      fab.classList.remove('playing');
      statusDot.classList.remove('playing');
      iconPlay.style.display = ''; iconPause.style.display = 'none';
      if (gain) rampTo(0);
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      if (reduce || !isOpen()) drawFlat(); else if (!idleTimer) drawIdleAnimated();
    }
    // The template's placeholder text is just a guess at what track will
    // load — reflect whichever one shuffling actually picked, immediately,
    // not only once build()/step() first runs from a click.
    setTitle(current);
    drawFlat();
    function startMeter() {
      if (reduce) { drawFlat(); return; }
      if (playing) { if (!raf) drawBars(); } else if (!idleTimer) drawIdleAnimated();
    }
    fab.addEventListener('click', function () {
      var open = panel.hidden;
      panel.hidden = !open;
      fab.setAttribute('aria-expanded', String(open));
      if (open) { setTitle(current); startMeter(); }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) { panel.hidden = true; fab.setAttribute('aria-expanded', 'false'); fab.focus(); }
    });
    btn.addEventListener('click', function () { playing ? mute() : play(); });
    prevBtn.addEventListener('click', function () { step(-1); });
    nextBtn.addEventListener('click', function () { step(1); });
    volDownBtn.addEventListener('click', function () { setVolume(volume - 0.1); });
    volUpBtn.addEventListener('click', function () { setVolume(volume + 0.1); });
    document.addEventListener('visibilitychange', function () {
      if (!audio) return;
      if (document.hidden && playing) audio.pause();
      else if (!document.hidden && playing) audio.play().catch(function () {});
    });
  })();
</script>

<style is:global>
  .music-player{position:fixed;left:16px;bottom:16px;z-index:25;display:flex;flex-direction:column-reverse;align-items:flex-start;gap:8px}
  .music-fab{position:relative;width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);background:color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:var(--accent);font-size:18px;cursor:pointer}
  .music-fab:hover,.music-fab[aria-expanded="true"]{border-color:var(--accent)}
  .music-live{position:absolute;top:6px;right:6px;width:6px;height:6px;border-radius:50%;background:transparent}
  .music-fab.playing .music-live{background:var(--accent2);box-shadow:0 0 6px var(--accent2)}
  .music-panel{display:flex;flex-direction:column;gap:7px;width:272px;padding:10px 12px;border:1px solid var(--line);
    background:color-mix(in srgb, var(--bg) 85%, transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  .music-panel[hidden]{display:none}
  .music-row{display:flex;align-items:center;gap:8px}
  .music-row-title{gap:6px}
  .music-note{color:var(--accent);font-size:13px;flex:none;line-height:1}
  .music-title-wrap{flex:1;min-width:0;overflow:hidden;position:relative}
  .music-title{display:inline-block;white-space:nowrap;font-family:var(--font-mono);font-size:11.5px;color:var(--fg)}
  .music-title-wrap.marquee .music-title{animation:music-marquee 11s linear infinite}
  @keyframes music-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .music-eq{display:block;width:100%;height:46px}
  .music-row-controls{justify-content:space-between}
  .music-transport{display:flex;align-items:center;gap:5px;flex:none}
  .music-btn{display:flex;align-items:center;justify-content:center;flex:none;cursor:pointer;color:var(--accent)}
  .music-btn-lg{width:32px;height:32px;background:var(--accent);color:var(--bg);border:0}
  .music-btn-lg svg{width:17px;height:17px}
  .music-btn-sm{width:22px;height:22px;background:none;border:1px solid var(--accent)}
  .music-btn-sm svg{width:12px;height:12px}
  .music-btn-sm:hover{background:color-mix(in srgb, var(--accent), transparent 85%)}
  .music-status{width:7px;height:7px;border-radius:50%;background:var(--muted);flex:none}
  .music-status.playing{background:var(--accent2);box-shadow:0 0 6px var(--accent2)}
  .music-vol{display:flex;align-items:center;gap:5px;flex:none}
  .music-vol-bar{width:40px;height:7px;background:var(--raised);overflow:hidden;flex:none}
  .music-vol-fill{display:block;height:100%;background:var(--accent);width:55%}
  .music-vol-pct{font-family:var(--font-mono);font-size:10px;color:var(--muted);width:28px;flex:none;text-align:right}
  @media (max-width:400px){.music-panel{width:calc(100vw - 32px)}}
</style>
