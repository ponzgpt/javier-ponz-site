---
// The whole page: a repair notebook, seven numbered pages. Every string comes from src/data/copy.mjs;
// `/` passes lang="en", `/es/` lang="es". The script (src/scripts/notebook.js) is the same for both and
// reads the strings it draws from the #nb-copy JSON block below.
import { copy, shared } from '../data/copy.mjs';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const t = copy[lang];
const c = t.cover, w = t.work, n = t.notes, s = t.stack, e = t.ethos;
const ext = { target: '_blank', rel: 'noreferrer' };
const me = { target: '_blank', rel: 'me noreferrer' };
const forScript = JSON.stringify({ ui: t.ui, work: { review: w.review }, map: t.map }).replace(/</g, '\\u003c');
const filters = Object.entries(s.filters);
const plugins = [
  ['Psychopomp', w.psychopomp, 18, 'https://github.com/ponzgpt/psychopomp', 'https://github.com/NousResearch/hermes-agent/pull/152559', '#152559'],
  ['Sabbath', w.sabbath, 13, 'https://github.com/ponzgpt/sabbath', 'https://github.com/NousResearch/hermes-agent/pull/152560', '#152560']
] as const;
const cards = [
  ['Neuronara', w.neuronara, 'https://neuronara.technoir.cloud', 'https://github.com/ponzgpt/neuronara'],
  ['ASI Rush', w.asiRush, 'https://asi-rush.technoir.cloud', 'https://github.com/ponzgpt/asi-rush']
] as const;
---
<script type="application/json" id="nb-copy" is:inline set:html={forScript}></script>
<button class="fold" id="fold" type="button" aria-pressed="false" aria-label={t.ui.foldToDark}><span class="f-under"></span><span class="f-flapw"><span class="f-flap"></span></span></button>
<nav class="lang" aria-label={t.ui.langNav} data-sketch="lang"><svg class="ov" aria-hidden="true"></svg><a href="/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined} aria-label={t.ui.langEn}>EN</a><a href="/es/" hreflang="es" lang="es" aria-current={lang === 'es' ? 'page' : undefined} aria-label={t.ui.langEs}>ES</a></nav>
<canvas id="doodle" aria-hidden="true"></canvas>

<div class="book">

<header class="spread cover" id="cover">
  <aside class="margin">
    <p class="pageno">{c.page}</p>
    <p class="note quiet">{c.note}</p>
    <div class="demo" id="demo" aria-hidden="true">
      <svg class="demo-ink" width="180" height="150" viewBox="0 0 180 150"><path class="dp" pathLength="1" d="M28 104 C 40 60, 92 52, 98 84 C 104 118, 54 120, 60 88 C 66 58, 132 50, 148 74"/><path class="dp" pathLength="1" d="M40 118 L 70 40 L 96 112 L 30 66 L 112 70 Z"/><path class="dp" pathLength="1" d="M22 72 C 34 48, 46 98, 60 72 S 86 48, 98 72 S 124 98, 136 72 S 156 52, 160 66"/></svg>
      <span class="cur"><svg width="18" height="24" viewBox="0 0 18 24"><circle class="tap" cx="2" cy="2" r="6"/><path class="arrow" d="M2 2 L2 19 L6.4 15 L9.4 21.6 L12.2 20.4 L9.3 14 L15 14 Z"/></svg></span>
    </div>
  </aside>
  <div class="main cover-main">
    <div class="hero">
      <h1>Javier Ponz</h1>
      <p class="hero-line" id="hero-line" set:html={c.heroLine} />
      <p class="lede">{c.lede}</p>
    </div>
    <figure class="photo">
      <img src="/javier-sketch-720.jpg" width="540" height="720" loading="eager" decoding="async" alt={c.photoAlt} />
    </figure>
    <div class="lw">
      <nav class="tabs links" aria-label={t.ui.linksNav} data-tabs>
        <svg class="ov" aria-hidden="true"></svg>
        <button class="tab" type="button" data-copy={shared.email} data-done={c.email.done} data-sel={c.email.sel} aria-label={c.email.aria}><b>{c.email.name}</b><small>{shared.email}</small></button>
        <a class="tab" href={shared.github} {...me}><b>GitHub</b><small>ponzgpt</small></a>
        <a class="tab" href={shared.cv} target="_blank" hreflang={lang === 'es' ? 'en' : undefined} type="application/pdf"><b>CV</b><small>{c.cvSmall}</small></a>
        <a class="tab" href={shared.x} {...me}><b>X</b><small>@sudotechnoir</small></a>
        <a class="tab" href={shared.linkedin} {...me}><b>LinkedIn</b><small>javierponz</small></a>
        <button class="tab" type="button" data-copy={shared.discord} data-done={c.discord.done} data-sel={c.discord.sel} aria-label={c.discord.aria}><b>{c.discord.name}</b><small>{shared.discord}</small></button>
        <span class="tab off" role="link" aria-disabled="true" aria-label={c.youtube.aria} title={c.youtube.aria}><b>YouTube</b><small>{c.youtube.small}</small><span class="stamp mini" data-sketch="stamp" aria-hidden="true"><svg class="ov" aria-hidden="true"></svg>{c.youtube.stamp}</span></span>
      </nav>
      <span class="vh" role="status"></span>
    </div>
  </div>
</header>

<section class="spread" id="story" aria-labelledby="h-story">
  <aside class="margin">
    <p class="pageno">{t.story.page}</p>
    <p class="note quiet">{t.story.note}</p>
  </aside>
  <div class="main">
    <h2 id="h-story"><span>{t.story.title}</span></h2>
    <div class="tl-wrap" data-sketch="tl"><svg class="ov" aria-hidden="true"></svg>
    <ol class="tl">
      {t.story.timeline.map((r) => <li><span class="when">{r.when}</span><span class="tl-dot"></span><div><h3>{r.title}</h3><p>{r.text}</p></div><span class="aside">{r.aside}</span></li>)}
    </ol>
    </div>
  </div>
</section>

<section class="spread" id="now" aria-labelledby="h-now">
  <aside class="margin">
    <p class="pageno">{t.now.page}</p>
    <p class="note quiet">{t.now.note}</p>
  </aside>
  <div class="main">
    <div class="h-row"><h2 id="h-now"><span>{t.now.title}</span></h2><span class="stamp" data-sketch="stamp"><svg class="ov" aria-hidden="true"></svg>{t.now.stamp}</span></div>
    <p class="lede" set:html={t.now.lede} />
    <p class="links-row">
      <a class="btn" data-sketch="btn" href={shared.mdib} {...ext}><svg class="ov" aria-hidden="true"></svg>mdib.technoir.cloud →</a>
      <a href={shared.newsletter} {...ext}>{t.now.newsletter}</a>
    </p>
    <p class="lede after">{t.now.after}</p>
  </div>
</section>

<section class="spread" id="work" aria-labelledby="h-work">
  <aside class="margin">
    <p class="pageno">{w.page}</p>
    <p class="note quiet">{w.note}</p>
  </aside>
  <div class="main">
    <h2 id="h-work"><span>{w.title}</span></h2>
    <article class="ticket hermes" data-sketch="ticket">
      <svg class="ov" aria-hidden="true"></svg>
      <div class="stub">{w.stub}</div>
      <div class="tk">
        <div class="tk-meta"><span>{w.kind}</span><span class="stamp" data-sketch="stamp"><svg class="ov" aria-hidden="true"></svg>{w.stamp}</span></div>
        <h3>{w.h3}</h3>
        <p class="fact">{w.fact}</p>
        <div class="plugs">
          {plugins.map(([name, text, tests, repo, pr, num]) => (
            <div class="plug">
              <h4>{name}</h4>
              <p>{text}</p>
              <div class="tally-row"><div class="tally" data-sketch="tally" data-n={tests}><svg class="ov" aria-hidden="true"></svg></div><span class="tally-n">{tests} {w.tests}</span></div>
              <p class="src"><a href={repo} {...ext}>{repo.replace('https://', '')}</a><br />{w.catalogPr} <a href={pr} {...ext}>hermes-agent {num}</a></p>
            </div>
          ))}
        </div>
        <p class="small strip-h">{w.stripHead}</p>
        <div class="sk strip" data-sketch="review" role="img" aria-label={w.stripAria}><svg></svg></div>
      </div>
    </article>
    <div class="cards">
      {cards.map(([name, d, live, src]) => (
        <article class="card" data-sketch="card"><svg class="ov" aria-hidden="true"></svg>
          <h4>{name}</h4><p class="kind">{d.kind}</p>
          <p>{d.text}</p>
          <p class="lnk"><a href={live} {...ext}>{live.replace('https://', '')}</a><a href={src} {...ext}>{w.source}</a></p>
        </article>
      ))}
    </div>
    <p class="more">{w.more} <a href={shared.github} {...ext}>github.com/ponzgpt →</a></p>
  </div>
</section>

<section class="spread" id="notes" aria-labelledby="h-notes">
  <aside class="margin">
    <p class="pageno">{n.page}</p>
  </aside>
  <div class="main">
    <h2 id="h-notes"><span>{n.title}</span></h2>
    <p class="lede">{n.lede}</p>
    <p class="cap">{n.caption}</p>
    <div class="ruled" data-sketch="ruled"><svg class="ov" aria-hidden="true"></svg>
      <ul class="notes">
        {shared.issues.map(([title, url], i) => <li><a href={url} {...ext}><b lang="es">{title}</b><span>{n.rows[i].text}</span><small>Beehiiv · {n.rows[i].when} <span class="arr" aria-hidden="true">↗</span></small></a></li>)}
      </ul>
    </div>
    <p class="links-row"><a href={shared.newsletter + '/archive'} {...ext}>{n.archive}</a><a href={shared.newsletter + '/subscribe'} {...ext}>{n.subscribe}</a><a href={shared.x} {...ext}>{n.onX}</a><a href={shared.linkedin} {...ext}>{n.onLinkedIn}</a></p>
  </div>
</section>

<section class="spread" id="stack" aria-labelledby="h-stack">
  <aside class="margin">
    <p class="pageno">{s.page}</p>
    <p class="note">{s.note}</p>
  </aside>
  <div class="main">
    <h2 id="h-stack"><span>{s.title}</span></h2>
    <p class="sub">{s.sub}</p>
    <div class="steps" data-sketch="steps"><svg class="ov" aria-hidden="true"></svg><ol aria-label={s.stepsAria}>
      {s.steps.map(([b, d], i) => <li><span class="sn" aria-hidden="true">{i + 1}</span><b>{b}</b><span>{d}</span></li>)}
    </ol></div>
    <div class="stack-list nojs" id="stack-list">
      <h3>{s.currentHead}</h3>
      <ul>{s.current.map((r) => <li data-n={r.length > 1 ? r[0] : undefined}>{r[r.length - 1]}</li>)}</ul>
      <h3>{s.progressHead}</h3>
      <ul>{s.progress.map((r) => <li data-n={r.length > 1 ? r[0] : undefined}>{r[r.length - 1]}</li>)}</ul>
    </div>
  </div>
  <div class="map jsonly" id="map">
    <p class="cap">{s.mapCap}</p>
    <div class="tabs filters jsonly" role="group" aria-label={s.filtersAria} data-tabs>
      <svg class="ov" aria-hidden="true"></svg>
      {filters.map(([k, label]) => <button class="tab" type="button" data-layer={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{label}</button>)}
    </div>
    <div class="stage" id="stage" data-sketch="map"><svg aria-hidden="true"></svg></div>
    <div class="slot"><div class="mcard" data-sketch="frame" aria-live="polite"><svg class="ov" aria-hidden="true"></svg><div class="mc-body"></div></div></div>
  </div>
</section>

<section class="spread" id="ethos" aria-labelledby="h-ethos">
  <aside class="margin">
    <p class="pageno">{e.page}</p>
    <p class="note quiet">{e.note}</p>
  </aside>
  <div class="main">
    <h2 id="h-ethos"><span>{e.title}</span></h2>
    <h3 class="grp">{e.work}</h3>
    <ol class="ethos" role="list">
      {e.theses.slice(0, 5).map(([h, p], i) => <li data-sketch="thesis"><svg class="ov" aria-hidden="true"></svg><span class="num" aria-hidden="true">{i + 1}</span><div><h4 set:html={h} /><p>{p}</p></div></li>)}
    </ol>
    <h3 class="grp">{e.believe}</h3>
    <ol class="ethos" role="list" start="6">
      {e.theses.slice(5).map(([h, p], i) => <li data-sketch="thesis"><svg class="ov" aria-hidden="true"></svg><span class="num" aria-hidden="true">{i + 6}</span><div><h4 set:html={h} /><p>{p}</p></div></li>)}
    </ol>
    <p class="made" set:html={e.made} />
  </div>
</section>

</div>

<script>
  import '../scripts/notebook.js';
</script>
