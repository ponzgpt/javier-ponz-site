---
// An actual shell, not a picture of one. The commands read the same data
// files the rest of the site renders from, so the terminal cannot drift out
// of date with the sections around it. `read` prints the longer essays from
// pages.mjs that the page itself no longer shows in full.
//
// The seeded `help` output is rendered server-side, so the box is complete
// and readable at rest: with JavaScript off it is a normal <pre> of text.
import { projects, running, skillGroups } from '../data/site';
import { person, profile, personEs, profileEs } from '../data/cv.mjs';
import { portrait, banner } from '../data/portrait.mjs';
import { pages } from '../data/pages.mjs';
import { ui, fastfetchIcons } from '../data/ui.mjs';
import { locales, pick } from '../data/i18n.mjs';

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const name = person.name;
const location = lang === 'en' ? person.location : personEs.location;
const headline = lang === 'en' ? person.headline : personEs.headline;
const profileLine = lang === 'en' ? profile[1] : profileEs[1];
const PROMPT = 'javier@techn0ir:~$';
const CONTACT_LABEL_ES = { Email: 'Correo', Phone: 'Teléfono', Site: 'Sitio' };

// The portrait and the wordmark live in data/portrait.mjs, shared with the hero
// and scripts/build-og.py.

// Omarchy Quattro ships fastfetch, not neofetch, with output boxed into
// titled sections (etc/fastfetch/config.jsonc in omacom/omarchy) — a plain
// top/bottom border per box, a tree-branch prefix per row ("│ ├" for a
// middle row, "└ └" for the last), first row flush with no prefix.
// Wide enough for the longest row (the Update line) to sit inside the border
// rather than poke out past it. Real specs run longer than the old one-liners.
// The portrait is drawn at more columns than the wordmark, so the two need
// different font-sizes to end up the width the layout wants. PORTRAIT_SCALE
// sets the portrait's width as a fraction of the wordmark's own natural
// width (bannerCols at 1em) — 0.89 is the widest the portrait can go while
// leaving the wordmark room to sit under it at full height, see below.
const bannerCols = Math.max(...banner.split('\n').map((l) => l.length));
const portraitCols = Math.max(...portrait.split('\n').map((l) => l.length));
const PORTRAIT_SCALE = 0.89;
const PORTRAIT_EM = (bannerCols * PORTRAIT_SCALE / portraitCols).toFixed(4);
// The wordmark used to render at a fixed fraction of that size, which made
// it narrower than the portrait above it and left a bare gap to its right —
// the block was only ever left-aligned inside a box sized for the wider
// portrait. Deriving BANNER_EM from the portrait's own rendered width instead
// (rather than a second guessed constant) makes the two exactly as wide as
// each other, however either is redrawn: bannerCols * BANNER_EM must equal
// portraitCols * PORTRAIT_EM.
const BANNER_EM = (portraitCols * Number(PORTRAIT_EM) / bannerCols).toFixed(4);

const BOX_WIDTH = 64;
const boxTop = (title) => {
  const rem = Math.max(0, BOX_WIDTH - title.length);
  const l = Math.floor(rem / 2);
  return '┌' + '─'.repeat(l) + title + '─'.repeat(rem - l) + '┐';
};
const boxBottom = '└' + '─'.repeat(BOX_WIDTH) + '┘';

const groups = t.term.factGroups.map((g) => ({
  ...g,
  rows: g.rows.map(([k, v], i) => [
    (i === 0 ? '' : i === g.rows.length - 1 ? '└ └' : '│ ├'),
    k,
    v
  ])
}));
// Icon *and* word — icon-only read worse than the plain label it replaced,
// so the key column is now "prefix + icon + label", padded as one string
// the same way the plain-text labels were before.
const keyOf = (prefix, k) => `${prefix}${fastfetchIcons[k] ?? '•'} ${k}`;
const KEYW = Math.max(...groups.flatMap((g) => g.rows.map(([prefix, k]) => keyOf(prefix, k).length))) + 2;
const pad = (s, w) => s + ' '.repeat(Math.max(1, w - s.length));
const esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Uptime's value gets an id: it's not the OS's uptime but time since Javier
// woke up, ticked live by the script below rather than baked once at build
// time (see ui.mjs for why the row's own text is only a placeholder).
const factsHtml = groups.map((g) => [
  `<span class="box">${esc(boxTop(g.title))}</span>`,
  g.rows.map(([prefix, k, v]) => `<span class="k" style="color:var(--${g.color})">${esc(pad(keyOf(prefix, k), KEYW))}</span><span class="v"${k === 'Uptime' ? ' id="ff-uptime"' : ''}>${esc(v)}</span>`).join('\n'),
  `<span class="box">${esc(boxBottom)}</span>`
].join('\n')).join('\n\n');

// Logo on the left, facts on the right — like fastfetch itself. Built as one
// string with no whitespace between the two <span> children so nothing sits
// between them as a stray text node inside the flex row.
const ffHtml = `<span class="ff"><span class="art" aria-hidden="true"><span class="face" style="font-size:${PORTRAIT_EM}em">${portrait}</span>\n<span class="mark" style="font-size:${BANNER_EM}em">${banner}</span></span>`
  + `<span class="ffinfo">${factsHtml}</span></span>`;

// `read <topic>`: a pages.mjs essay block flattened to plain lines.
const strip = (html) => String(html).replace(/<\/(p|h2|h3|cite)>/g, '\n').replace(/<cite>/g, '— ').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').split('\n').map((l) => l.trim()).filter(Boolean);
const readTopic = (block) => {
  const b = pages[block][lang];
  const lines = [];
  if (b.epigraph) lines.push(...strip(b.epigraph), '');
  if (b.h1) lines.push({ h: b.h1 + b.serif + b.h1end });
  if (b.lede) lines.push(b.lede);
  if (b.status) lines.push('', b.status);
  for (const sec of b.sections ?? []) lines.push('', { h: sec.label }, ...strip(sec.html));
  return lines;
};
const topics = t.topics.map(([id, block, note]) => ({ id, note, lines: readTopic(block) }));

// Everything the client-side commands need, and nothing more.
const data = {
  name, location, headline,
  profile: profileLine,
  projects: projects.map((x) => pick(x, lang)).map((x) => ({ t: x.title, k: x.kind, s: x.status, by: x.by, d: x.description, u: x.url })),
  running: running.map((x) => pick(x, lang)).map((x) => ({ t: x.title, k: x.kind, by: x.by, d: x.description, u: x.url })),
  skills: skillGroups.map((g) => pick(g, lang)).map((g) => ({ g: g.name, items: g.items })),
  contact: person.contact.filter((c) => !c.private).map((c) => ({ l: lang === 'es' ? (CONTACT_LABEL_ES[c.label] ?? c.label) : c.label, v: c.value, h: c.href })),
  pages: t.pages,
  cvPath: '/javier-ponz-prado-cv.pdf',
  topics,
  langs: locales.map((l) => ({ id: l.code, name: l.name, home: l.code === 'en' ? '/' : `/${l.code}/` })),
  curLang: lang,
  help: t.term.help,
  s: t.term.strings,
  pausedTag: t.pausedTag,
  treeHint: t.treeHint,
  treeThisSite: t.treeThisSite,
  ffHtml,
  hint: t.term.hint,
  prompt: PROMPT
};
---
<section class="term-wrap" aria-labelledby="term-title">
  <div class="win">
    <div class="bar"><span id="term-title">{t.term.title}</span><span class="bar-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
    <div class="term" id="term">
      <div class="out-wrap">
        <pre class="out" id="term-out" tabindex="0" role="log" aria-live="polite"><span class="cmd">{PROMPT} help</span>
<span class="k">{t.term.strings.commands}</span>
{t.term.help.map(([c, d]) => `  ${c.padEnd(16)}${d}\n`).join('')}
<span class="hint" set:html={t.term.hint} />
</pre>
        <div class="scroll-fade" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
      <form class="line" id="term-form" autocomplete="off">
        <label for="term-in">{PROMPT}</label>
        <span class="cursor" aria-hidden="true"></span>
        <input id="term-in" name="c" type="text" spellcheck="false" autocapitalize="off"
               aria-describedby="term-title" placeholder="help" />
      </form>
    </div>
  </div>
</section>

<script is:inline>
  /* The fastfetch "Uptime" row is not the OS's uptime but time since Javier
     woke up: elapsed since a fixed 5:30 Europe/London. It only exists while
     fastfetch output is on screen, so it is looked up fresh each tick. */
  (function () {
    var fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    function pad2(n) { return (n < 10 ? '0' : '') + n; }
    setInterval(function () {
      var upEl = document.getElementById('ff-uptime');
      if (!upEl || document.hidden) return;
      var p = {};
      fmt.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
      var secs = (+p.hour) * 3600 + (+p.minute) * 60 + (+p.second) - (5 * 3600 + 30 * 60);
      if (secs < 0) secs += 24 * 3600;
      upEl.textContent = pad2(Math.floor(secs / 3600)) + ':' + pad2(Math.floor(secs / 60) % 60) + ':' + pad2(secs % 60);
    }, 1000);
  })();
</script>

<script is:inline define:vars={{ data }}>
(function () {
  var out = document.getElementById('term-out');
  var form = document.getElementById('term-form');
  var input = document.getElementById('term-in');
  var fade = document.querySelector('.scroll-fade');
  if (!out || !form || !input) return;

  // Whenever there's more of the box below the visible edge — mainly on a
  // phone, where the portrait+wordmark alone can already fill the capped
  // height, leaving the specs underneath invisible with nothing hinting they
  // exist. 1px of slack absorbs sub-pixel rounding so it doesn't flicker at
  // the exact bottom.
  function updateFade() {
    if (fade) fade.classList.toggle('show', out.scrollHeight - out.scrollTop - out.clientHeight > 1);
  }

  // Measured, not guessed: the three workspaces (and typed commands, which
  // keep appending to whichever is showing) are never the same length, and a
  // hand-picked pixel height is wrong for one of them the moment any of them
  // changes — this box has already been clipped on desktop and trapped
  // scroll on mobile from exactly that. Read the real content height after
  // every render instead, and only cap it on a narrow viewport, where
  // letting it fill the screen is the actual problem; a normal desktop has
  // the room, so it just gets to be as tall as it needs to be.
  function fitOut() {
    // scrollHeight already reports the content's full height regardless of
    // the box's own current (explicit or clipped) height, so there is no
    // need to release it to 'auto' first — doing that would also force an
    // intermediate reflow the .out transition could snap through instead of
    // animating smoothly from its previous height.
    var natural = out.scrollHeight;
    var cap = innerWidth <= 700 ? innerHeight * 0.5 : Infinity;
    out.style.height = Math.round(Math.min(natural, cap)) + 'px';
    updateFade();
  }
  out.addEventListener('scroll', updateFade, { passive: true });

  var history = [], hpos = 0;

  function write(text, cls) {
    var el = document.createElement('span');
    if (cls) el.className = cls;
    el.textContent = text + '\n';
    out.appendChild(el);
  }
  function writeHtml(html, cls) {
    var el = document.createElement('span');
    if (cls) el.className = cls;
    el.innerHTML = html + '\n';
    out.appendChild(el);
  }
  function link(label, href, note) {
    var el = document.createElement('span');
    var a = document.createElement('a');
    a.href = href; a.textContent = label;
    if (/^https?:/.test(href)) { a.target = '_blank'; a.rel = 'noreferrer'; }
    el.appendChild(document.createTextNode('  '));
    el.appendChild(a);
    if (note) el.appendChild(document.createTextNode('  ' + note));
    el.appendChild(document.createTextNode('\n'));
    out.appendChild(el);
  }

  // Three full-box views (fastfetch, btop, tree), built from the same `data`
  // every other command reads, so they cannot drift from the project list.
  var CMD_ECHO = { '1': 'fastfetch', '2': 'btop', '3': 'ls -la ~/code' };
  var btopInterval = null;

  // Colour, like workspace 1's fastfetch card, not a flat single tone:
  // .k/.box are the same classes that card already defines (accent2
  // labels, muted borders) — reused here rather than inventing new ones.
  // pad()/width math measure *visible* length so a row can carry
  // `<span>` markup and still line up in the grid.
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function visibleLen(s) { return String(s).replace(/<[^>]*>/g, '').length; }
  function pad(s, w) { return s + ' '.repeat(Math.max(0, w - visibleLen(s))); }
  function tag(cls, text) { return '<span class="' + cls + '">' + esc(text) + '</span>'; }
  function label(text) { return tag('k', text); }
  function accent(text) { return '<span style="color:var(--accent)">' + esc(text) + '</span>'; }

  function box(title, width, rows) {
    var rem = Math.max(0, width - title.length - 2);
    var l = Math.floor(rem / 2);
    var top = tag('box', '┌' + '─'.repeat(l) + ' ' + title + ' ' + '─'.repeat(rem - l) + '┐');
    var bottom = tag('box', '└' + '─'.repeat(width) + '┘');
    var body = rows.map(function (r) { return tag('box', '│ ') + pad(r, width - 2) + tag('box', '│'); }).join('\n');
    return top + '\n' + body + '\n' + bottom;
  }
  // Two boxes of possibly different height, joined line-by-line — real
  // btop tiles MEM/DISKS/PROC side by side rather than stacking them.
  function sideBySide(a, b, gap) {
    gap = ' '.repeat(gap || 2);
    var al = a.split('\n'), bl = b.split('\n');
    var aw = Math.max.apply(null, al.map(visibleLen));
    var n = Math.max(al.length, bl.length);
    var out2 = [];
    for (var i = 0; i < n; i++) out2.push(pad(al[i] || '', aw) + gap + (bl[i] || ''));
    return out2.join('\n');
  }
  function bar(pct, width) {
    width = width || 21;
    var filled = Math.max(0, Math.min(width, Math.round(width * pct / 100)));
    return '█'.repeat(filled) + '░'.repeat(width - filled);
  }
  function jitter(base, spread) {
    return Math.max(2, Math.min(98, base + (Math.random() * 2 - 1) * spread));
  }

  function renderFastfetch() {
    out.insertAdjacentHTML('beforeend', data.ffHtml);
    write('');
    var hintEl = document.createElement('span');
    hintEl.className = 'hint';
    hintEl.innerHTML = data.hint;
    out.appendChild(hintEl);
  }

  // A btop-style layout: one CPU box with a two-column core grid (real
  // btop's own convention once you have more than 4-6 cores), then MEM and
  // DISKS tiled side by side, then PROC — same shape as the actual Omarchy
  // Quattro desktop, not just a single flat box.
  // Numbers taken from Javier's actual rig (Ryzen 9 9900X3D, 60.5 GiB RAM,
  // a 1.82 TiB btrfs root, a read-only external mount pinned at 100%) rather
  // than invented, so the simulated monitor at least describes a real machine.
  // All 24 threads, not a sample of 8: the terminal is a fixed height now, and
  // a real btop on this machine fills that height rather than leaving two
  // thirds of the window empty. Same reason for the GPU and NET boxes below —
  // btop draws them, and they are the panels a 5090 owner would actually watch.
  var CORES = [], MEM = 12, VRAM = 34, START = Date.now();
  for (var ci = 0; ci < 24; ci++) CORES.push(8 + Math.random() * 70);
  var NET_DOWN = 6.2, NET_UP = 1.1;
  function uptimeStr() {
    var s = Math.floor((Date.now() - START) / 1000);
    return Math.floor(s / 60) + 'm ' + (s % 60) + 's';
  }
  function renderBtopBody() {
    var old = document.getElementById('btop-live');
    CORES = CORES.map(function (c) { return jitter(c, 6); });
    MEM = jitter(MEM, 3); VRAM = jitter(VRAM, 4);
    NET_DOWN = Math.max(0.1, jitter(NET_DOWN, 2)); NET_UP = Math.max(0.1, jitter(NET_UP, 0.6));
    // three columns of eight, which is how btop lays out a core count this high
    var coreLines = [], PER = 8;
    for (var i = 0; i < PER; i++) {
      var row = '';
      for (var c = 0; c < 3; c++) {
        var n = c * PER + i;
        var cell = label((n < 10 ? 'c0' : 'c') + n) + ' ' + bar(CORES[n], 8) + pad(' ' + Math.round(CORES[n]) + '%', 5);
        row += c < 2 ? pad(cell, 21) : cell;
      }
      coreLines.push(row);
    }
    var load = (CORES.reduce(function (a, c) { return a + c; }, 0) / CORES.length / 100).toFixed(2);
    var cpuBox = box('cpu — ryzen 9 9900x3d (24) — load ' + load + ' — up ' + uptimeStr(), 62, coreLines);
    var gpuTemp = Math.round(jitter(54, 4)), gpuUtil = jitter(VRAM + 18, 8);
    var gpuBox = box('gpu — rtx 5090', 30, [
      label('util ') + bar(gpuUtil, 10) + ' ' + Math.round(gpuUtil) + '%',
      label('vram ') + bar(VRAM, 10) + ' ' + Math.round(VRAM) + '%',
      label('temp ') + gpuTemp + '°C   ' + label('fan ') + Math.round(jitter(38, 5)) + '%'
    ]);
    var netBox = box('net — wlan0', 30, [
      label('down ') + NET_DOWN.toFixed(1) + ' MiB/s  ' + bar(Math.min(100, NET_DOWN * 8), 6),
      label('up   ') + NET_UP.toFixed(1) + ' MiB/s  ' + bar(Math.min(100, NET_UP * 20), 6),
      label('total') + '  412 GiB down / 38 GiB up'
    ]);
    var memBox = box('mem', 30, [
      label('total') + '  60.5G',
      label('used ') + bar(MEM, 10) + ' ' + Math.round(MEM) + '%',
      label('avail') + '  ' + (60.5 * (1 - MEM / 100)).toFixed(1) + 'G'
    ]);
    var rootPct = jitter(4, 1);
    var disksBox = box('disks', 30, [
      label('/    ') + bar(rootPct, 10) + ' ' + Math.round(rootPct) + '%',
      label('/home') + bar(jitter(31, 2), 10) + ' 31%',
      label('iso  ') + bar(100, 10) + ' 100%'
    ]);
    var procBox = box('proc', 62, [
      tag('box', 'PID     CMD                          CPU%    MEM%    USER'),
      label('1024') + '    hermes-agent --daemon        ' + pad(jitter(9, 3).toFixed(1), 8) + '2.1     javier',
      label('1187') + '    astro dev --host             ' + pad(jitter(3, 2).toFixed(1), 8) + '1.4     javier',
      label('1402') + '    hyprland                     ' + pad(jitter(2.2, 1).toFixed(1), 8) + '1.9     javier',
      label('2044') + '    ollama serve ' + data.pausedTag + pad('', 15 - data.pausedTag.length) + '0.0     0.0     javier',
      label('2390') + '    nginx: worker process        ' + pad(jitter(0.6, 0.4).toFixed(1), 8) + '0.3     http',
      label('3102') + '    fzf                          0.1     0.1     javier'
    ]);
    var html = cpuBox + '\n\n' + sideBySide(gpuBox, netBox, 2) + '\n\n'
      + sideBySide(memBox, disksBox, 2) + '\n\n' + procBox;
    var el = old || document.createElement('span');
    el.id = 'btop-live';
    el.innerHTML = html;
    if (!old) out.appendChild(el);
  }
  function renderBtop() {
    renderBtopBody();
  }

  // A two-command filesystem view, like Omarchy's own file manager + tree
  // pane: a coloured `ls -la` of the real repos first, then a real `tree`
  // of this very site's own layout underneath.
  function folderName(url) { return url.split('/').pop(); }
  function renderTree() {
    var items = data.projects.map(function (p) { return { name: folderName(p.u), tag: p.s }; });
    items.push({ name: 'javier-ponz-site', tag: data.treeThisSite });
    writeHtml(tag('box', 'Permissions  Size  User     Name'));
    items.forEach(function (it) {
      writeHtml(tag('box', 'drwxr-xr-x   -     javier   ') + pad(label(it.name + '/'), 25) + accent('[' + it.tag + ']'));
    });
    write('');
    var hintEl = document.createElement('span');
    hintEl.innerHTML = data.treeHint + '\n';
    out.appendChild(hintEl);
    write('');
    var cmd2 = document.createElement('span');
    cmd2.className = 'cmd';
    cmd2.textContent = 'javier@techn0ir:~/code/javier-ponz-site$ tree -L 3\n';
    out.appendChild(cmd2);
    writeHtml(accent('javier-ponz-site'));
    // Three levels rather than two, and the real filenames: the terminal is a
    // fixed height now, so this is the depth that fills the window — and a
    // tree of directory names alone tells a reader nothing about the project.
    ['├── src',
      '│   ├── components',
      '│   │   ├── sections',
      '│   │   └── Terminal.astro',
      '│   ├── data',
      '│   │   ├── pages.mjs',
      '│   │   ├── site.ts',
      '│   │   ├── skins.mjs',
      '│   │   └── ui.mjs',
      '│   ├── layouts',
      '│   └── pages',
      '├── public',
      '│   ├── audio',
      '│   └── favicon.svg',
      '├── scripts',
      '├── docs',
      '└── Dockerfile'
    ].forEach(function (l) {
      var m = l.match(/^([│├└─\s]+)(.*)$/);
      var name = m ? m[2] : l;
      var isDir = name.indexOf('.') === -1;
      writeHtml(m ? tag('box', m[1]) + (isDir ? accent(name) : label(name)) : accent(name));
    });
    write('');
    writeHtml(tag('box', '8 directories, 23 files'));
  }

  var RENDER = { '1': renderFastfetch, '2': renderBtop, '3': renderTree };
  function switchWorkspace(n) {
    if (!RENDER[n]) return;
    out.innerHTML = '';
    var el = document.createElement('span');
    el.className = 'cmd';
    el.textContent = data.prompt + ' ' + CMD_ECHO[n] + '\n\n';
    out.appendChild(el);
    RENDER[n]();
    fitOut();
    out.scrollTop = 0;
    if (btopInterval) { clearInterval(btopInterval); btopInterval = null; }
    if (n === '2') btopInterval = setInterval(function () { if (!document.hidden) renderBtopBody(); }, 2500);
  }

  var commands = {
    fastfetch: function () { switchWorkspace('1'); },
    btop: function () { switchWorkspace('2'); },
    tree: function () { switchWorkspace('3'); },
    help: function () {
      write(data.s.commands, 'k');
      data.help.forEach(function (c) { write('  ' + pad(c[0], 16) + c[1]); });
    },
    whoami: function () {
      write(data.name + ' — ' + data.location, 'who');
      write(data.headline, 'k');
      write('');
      write(data.profile);
    },
    ls: function () {
      data.pages.forEach(function (p) { link(pad(p[0], 12) + p[2], p[1]); });
    },
    open: function (arg) {
      var hit = data.pages.filter(function (p) { return p[0] === arg; })[0];
      if (!hit) { write(data.s.noPage + '"' + (arg || '') + '"' + data.s.tryLs, 'err'); return; }
      write(data.s.opening + hit[1] + ' …');
      setTimeout(function () { location.href = hit[1]; }, 220);
    },
    projects: function () {
      data.projects.forEach(function (p) {
        write('');
        write(p.t + '  [' + p.s + ' · ' + p.k + ']', 'who');
        write('  ' + p.by, 'k');
        write('  ' + p.d);
        link(data.s.source, p.u);
      });
    },
    running: function () {
      data.running.forEach(function (r) {
        write('');
        write(r.t + '  [' + r.k + ']', 'who');
        write('  ' + r.by, 'k');
        write('  ' + r.d);
        link(data.s.upstream, r.u);
      });
    },
    skills: function () {
      data.skills.forEach(function (s) {
        write('');
        write(s.g, 'who');
        write('  ' + s.items.join(', '));
      });
    },
    cv: function () {
      write(data.headline, 'who');
      write('');
      write(data.profile);
      write('');
      link(data.s.dlPdf, data.cvPath);
    },
    contact: function () {
      data.contact.forEach(function (c) { if (c.h) link(pad(c.l, 10) + c.v, c.h); else write('  ' + pad(c.l, 10) + c.v); });
    },
    read: function (arg) {
      var hit = data.topics.filter(function (x) { return x.id === arg; })[0];
      if (!arg || !hit) {
        if (arg) write(data.s.noTopic + '"' + arg + '"', 'err');
        write(data.s.topics, 'k');
        data.topics.forEach(function (x) { write('  read ' + pad(x.id, 12) + x.note); });
        return;
      }
      hit.lines.forEach(function (l) {
        if (l && l.h) write(l.h, 'who'); else write(l);
      });
    },
    lang: function (arg) {
      var ids = data.langs.map(function (l) { return l.id; });
      if (!arg) {
        write(data.s.langsCurrent + data.curLang + ')', 'k');
        data.langs.forEach(function (l) { write('  ' + pad(l.id, 12) + l.name); });
        write('');
        write(data.s.langsHint);
        return;
      }
      if (ids.indexOf(arg) < 0) { write(data.s.noLang + '"' + arg + '"', 'err'); return; }
      var hit = data.langs.filter(function (l) { return l.id === arg; })[0];
      var url = new URL(hit.home, location.origin);
      write('lang → ' + arg + ' …');
      setTimeout(function () { location.href = url.toString(); }, 220);
    },
    clear: function () { out.textContent = ''; },
    sudo: function () { write(data.s.sudo, 'err'); }
  };

  function run(raw) {
    var parts = raw.trim().split(/\s+/);
    var cmd = (parts.shift() || '').toLowerCase();
    var arg = (parts.shift() || '').toLowerCase();
    var el = document.createElement('span');
    el.className = 'cmd';
    el.textContent = data.prompt + ' ' + raw + '\n';
    out.appendChild(el);
    if (!cmd) { fitOut(); return; }
    if (commands[cmd]) commands[cmd](arg);
    else write(cmd + data.s.notFound, 'err');
    write('');
    fitOut();
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var raw = input.value;
    if (raw.trim()) { history.push(raw); hpos = history.length; }
    input.value = '';
    run(raw);
    out.scrollTop = out.scrollHeight;
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowUp' && hpos > 0) { e.preventDefault(); input.value = history[--hpos]; }
    else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (hpos < history.length - 1) input.value = history[++hpos];
      else { hpos = history.length; input.value = ''; }
    } else if (e.key === 'Tab') {
      e.preventDefault();
      var typed = input.value.trim();
      var head = typed.split(/\s+/)[0];
      var pool = typed.indexOf(' ') > -1
        ? (head === 'read'
            ? data.topics.map(function (x) { return 'read ' + x.id; })
            : head === 'lang'
              ? data.langs.map(function (x) { return 'lang ' + x.id; })
              : data.pages.map(function (x) { return 'open ' + x[0]; }))
        : Object.keys(commands);
      var hits = pool.filter(function (c) { return c.indexOf(typed) === 0; });
      if (hits.length === 1) input.value = hits[0] + ' ';
      else if (hits.length > 1) { run(typed); write(hits.join('  ')); write(''); fitOut(); }
    }
  });

  // Establishes the box's real height against the SSR fastfetch content
  // already sitting in the DOM, then keeps it correct across an orientation
  // flip or the browser window being resized past the 700px cap threshold.
  fitOut();
  var fitResizeTimer;
  addEventListener('resize', function () {
    clearTimeout(fitResizeTimer);
    fitResizeTimer = setTimeout(fitOut, 120);
  });
})();
</script>

<style is:global>
  /* Global rather than scoped: .art/.k/.v/.box/.ff/.ffinfo are generated as
     raw HTML (set:html, innerHTML), so they never carry Astro's scope. */
  .win{--term-bg:color-mix(in srgb, var(--bg), #000 35%);border:1px solid var(--line);background:var(--term-bg);box-shadow:0 0 0 1px color-mix(in srgb, var(--accent) 12%, transparent), 0 30px 80px -40px var(--glow)}
  .win .bar{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;border-bottom:1px solid var(--line);font-family:var(--font-mono);font-size:12px;color:var(--muted)}
  .bar-dots{display:flex;gap:6px}
  .bar-dots i{width:8px;height:8px;border-radius:50%;background:var(--line)}
  .bar-dots i:first-child{background:var(--accent)}
  .term{padding:14px 16px 12px;font-family:var(--font-mono)}
  .out{margin:0;white-space:pre-wrap;word-break:break-word;font-size:12.5px;line-height:1.55;color:var(--fg);
    /* Height is measured in JS (fitOut) after every render, capped on narrow
       screens; the transition keeps view switches from jumping. */
    overflow:auto;scrollbar-width:thin;max-height:480px;transition:height .18s ease}
  .out-wrap{position:relative}
  .scroll-fade{position:absolute;left:0;right:0;bottom:0;height:34px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:3px;
    background:linear-gradient(180deg,transparent,var(--term-bg) 75%);color:var(--muted);pointer-events:none;opacity:0;transition:opacity .2s ease}
  .scroll-fade.show{opacity:1}
  .scroll-fade svg{width:13px;height:13px}
  .out .cmd{color:var(--muted)}
  .out .ff{display:flex;align-items:flex-start;gap:24px;margin:6px 0 12px}
  .out .art{display:block;flex:none;white-space:pre;font-size:min(1.1vw,12px);line-height:1;font-weight:700;margin:0;overflow-x:auto;overflow-y:hidden;
    background:linear-gradient(180deg,var(--accent) 0%,var(--accent2) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  @supports not (background-clip:text){.out .art{-webkit-text-fill-color:currentColor;color:var(--accent)}}
  .out .face,.out .mark{display:block;white-space:pre;line-height:1}
  .out .ffinfo{display:block;flex:1;min-width:0}
  .out .k{color:var(--accent2)}
  .out .v{color:var(--fg)}
  .out .box{color:var(--muted)}
  .out .who{color:var(--accent)}
  .out .err{color:var(--muted)}
  .out .hint{display:block;margin-top:10px;color:var(--muted)}
  .out .hint b{color:var(--accent);font-weight:700}
  .out a{color:var(--accent);text-decoration-color:var(--accent2)}
  .line{display:flex;align-items:baseline;gap:9px;margin-top:10px;border-top:1px solid var(--line);padding-top:10px}
  .line label{color:var(--accent2);font-size:12.5px;white-space:nowrap}
  /* A block cursor invites the first click; the real caret takes over on focus. */
  .cursor{width:8px;height:15px;flex:none;align-self:center;background:var(--accent)}
  .line:not(:focus-within) .cursor{animation:blink 1.1s steps(1) infinite}
  .line:focus-within .cursor{display:none}
  .line input{flex:1;min-width:0;background:none;border:0;outline:none;color:var(--fg);font:inherit;font-size:13px;caret-color:var(--accent)}
  .line input::placeholder{color:var(--muted)}
  .line:focus-within{border-top-color:var(--accent)}
  @media (max-width:860px){.out .ff{flex-direction:column;gap:10px}.out .art{font-size:min(1.6vw,12px)}}
  @media (max-width:700px){.out{font-size:11.5px}}
</style>
