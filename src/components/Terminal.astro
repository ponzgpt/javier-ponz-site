---
// An actual shell, not a picture of one. The commands read the same data files
// the rest of the site renders from, so the terminal cannot drift out of date
// with the pages beneath it.
//
// The seeded `neofetch` output is rendered server-side, so the page is complete
// and readable at rest — with JavaScript off, or for a crawler, this is a
// normal <pre> full of real text.
import { projects, running, skillsFor } from '../data/site';
import { person, cvFor } from '../data/cv.mjs';
import { skins } from '../data/skins.mjs';
import { ui, t, href, locales, pick } from '../data/i18n.mjs';

const { lang = 'en' } = Astro.props;
const cv = cvFor(lang);
const bareHere = '/';

const banner = `     ██╗ █████╗ ██╗   ██╗██╗███████╗██████╗
     ██║██╔══██╗██║   ██║██║██╔════╝██╔══██╗
     ██║███████║██║   ██║██║█████╗  ██████╔╝
██   ██║██╔══██║╚██╗ ██╔╝██║██╔══╝  ██╔══██╗
╚█████╔╝██║  ██║ ╚████╔╝ ██║███████╗██║  ██║
 ╚════╝ ╚═╝  ╚═╝  ╚═══╝  ╚═╝╚══════╝╚═╝  ╚═╝
██████╗  ██████╗ ███╗   ██╗███████╗
██╔══██╗██╔═══██╗████╗  ██║╚══███╔╝
██████╔╝██║   ██║██╔██╗ ██║  ███╔╝
██╔═══╝ ██║   ██║██║╚██╗██║ ███╔╝
██║     ╚██████╔╝██║ ╚████║███████╗
╚═╝      ╚═════╝ ╚═╝  ╚═══╝╚══════╝`;

const facts = t(ui.term.facts, lang);

// A CJK glyph occupies two cells in a monospace grid but is one JS character,
// so padEnd() alone leaves the column ragged. Pad by display width instead.
const cells = (str) => [...str].reduce((n, ch) => n + (/[\u1100-\u115F\u2E80-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFE30-\uFE4F\uFF00-\uFF60\uFFE0-\uFFE6]/.test(ch) ? 2 : 1), 0);
const padCells = (str, width) => str + ' '.repeat(Math.max(1, width - cells(str)));
const KEYW = Math.max(...facts.map(([k]) => cells(k))) + 2;

const esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const factsHtml = facts
  .map(([k, v]) => `<span class="k">${esc(padCells(k, KEYW))}</span><span class="v">${esc(v)}</span>`)
  .join('\n');

// Everything the client-side commands need, and nothing more.
const data = {
  name: person.name,
  location: cv.location,
  headline: cv.headline,
  profile: cv.profile[1],
  projects: projects.map((x) => pick(x, lang)).map((x) => ({ t: x.title, k: x.kind, s: x.status, by: x.by, d: x.description, u: x.url })),
  running: running.map((x) => pick(x, lang)).map((x) => ({ t: x.title, k: x.kind, by: x.by, d: x.description, u: x.url })),
  skills: skillsFor(lang).map((g) => ({ g: g.group, items: g.items })),
  contact: person.contact.filter((c) => !c.private).map((c) => ({ l: c.label, v: c.value, h: c.href })),
  pages: t(ui.pages, lang).map(([name, path, note]) => [name, href(path, lang), note]),
  cvPath: '/javier-ponz-prado-cv.pdf',
  skins: skins.map((x) => ({ id: x.id, name: x.name, note: x.note })),
  langs: locales.map((l) => ({ code: l.code, label: l.label, name: l.name, url: href(bareHere, l.code) })),
  lang,
  help: t(ui.term.help, lang),
  s: Object.fromEntries(Object.entries(ui.term.strings).map(([k, v]) => [k, t(v, lang)]))
};
---
<section class="term-wrap" aria-labelledby="term-title">
  <div class="win">
    <div class="bar">
      <span class="ws"><b>1</b><i></i><i></i></span>
      <span class="wtitle" id="term-title">{t(ui.term.title, lang)}</span>
      <span class="wstat"><span class="dot"></span>{t(ui.term.online, lang)}</span>
    </div>
    <div class="term" id="term">
      <pre class="out" id="term-out" tabindex="0" role="log" aria-live="polite"><span class="cmd">javier@aberdeen ~ <b>❯</b> neofetch</span>
<span class="art">{banner}</span>
<span class="who">{data.name} — {data.location}</span>
<Fragment set:html={factsHtml} />
<span class="hint" set:html={t(ui.term.hint, lang)} />
</pre>
      <form class="line" id="term-form" autocomplete="off">
        <label for="term-in">javier@aberdeen ~ <b>❯</b></label>
        <input id="term-in" name="c" type="text" spellcheck="false" autocapitalize="off"
               aria-describedby="term-title" placeholder="help" />
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ data }}>
(function () {
  var out = document.getElementById('term-out');
  var form = document.getElementById('term-form');
  var input = document.getElementById('term-in');
  if (!out || !form || !input) return;

  var history = [], hpos = 0;
  var pad = function (s, n) { return (s + '          ').slice(0, n); };

  function write(text, cls) {
    var el = document.createElement('span');
    if (cls) el.className = cls;
    el.textContent = text + '\n';
    out.appendChild(el);
  }
  function link(label, href, note) {
    var el = document.createElement('span');
    var a = document.createElement('a');
    a.href = href; a.textContent = label;
    if (/^https?:/.test(href)) { a.target = '_blank'; a.rel = 'noreferrer'; }
    el.appendChild(document.createTextNode('  '));
    el.appendChild(a);
    if (note) el.appendChild(document.createTextNode('  ' + note));
    el.appendChild(document.createTextNode('\n'));
    out.appendChild(el);
  }

  var commands = {
    help: function () {
      write(data.s.commands, 'k');
      data.help.forEach(function (c) { write('  ' + pad(c[0], 16) + c[1]); });
    },
    whoami: function () {
      write(data.name + ' — ' + data.location, 'who');
      write(data.headline, 'k');
      write('');
      write(data.profile);
    },
    ls: function () {
      data.pages.forEach(function (p) { link(pad(p[0], 12) + p[2], p[1]); });
    },
    open: function (arg) {
      var hit = data.pages.filter(function (p) { return p[0] === arg; })[0];
      if (!hit) { write(data.s.noPage + '"' + (arg || '') + '"' + data.s.tryLs, 'err'); return; }
      write(data.s.opening + hit[1] + ' …');
      setTimeout(function () { location.href = hit[1]; }, 220);
    },
    projects: function () {
      data.projects.forEach(function (p) {
        write('');
        write(p.t + '  [' + p.s + ' · ' + p.k + ']', 'who');
        write('  ' + p.by, 'k');
        write('  ' + p.d);
        link(data.s.source, p.u);
      });
    },
    running: function () {
      data.running.forEach(function (r) {
        write('');
        write(r.t + '  [' + r.k + ']', 'who');
        write('  ' + r.by, 'k');
        write('  ' + r.d);
        link(data.s.upstream, r.u);
      });
    },
    skills: function () {
      data.skills.forEach(function (s) {
        write('');
        write(s.g, 'who');
        write('  ' + s.items.join(', '));
      });
    },
    cv: function () {
      write(data.headline, 'who');
      write('');
      write(data.profile);
      write('');
      link(data.s.fullCv, data.pages.filter(function (x) { return x[0] === 'cv'; })[0][1]);
      link(data.s.dlPdf, data.cvPath);
    },
    contact: function () {
      data.contact.forEach(function (c) { link(pad(c.l, 10) + c.v, c.h); });
    },
    skin: function (arg) {
      var ids = data.skins.map(function (s) { return s.id; });
      if (!arg) {
        write(data.s.skinsCurrent + document.documentElement.dataset.skin + ')', 'k');
        data.skins.forEach(function (s) { write('  ' + pad(s.id, 12) + s.name + ' — ' + s.note); });
        write('');
        write(data.s.skinsHint);
        return;
      }
      if (ids.indexOf(arg) < 0) { write(data.s.noSkin + '"' + arg + '"', 'err'); return; }
      document.documentElement.dataset.skin = arg;
      try { localStorage.setItem('jp-skin', arg); } catch (e) {}
      var picker = document.getElementById('skinpicker');
      if (picker) {
        picker.querySelectorAll('[data-skin-set]').forEach(function (b) {
          var on = b.dataset.skinSet === arg;
          b.setAttribute('aria-checked', String(on));
          if (on) document.getElementById('skin-name').textContent = b.querySelector('.sk-name').textContent;
        });
      }
      write('skin → ' + arg);
    },
    neofetch: function () { location.reload(); },
    clear: function () { out.textContent = ''; },
    lang: function (arg) {
      if (!arg) {
        write(data.s.langsCurrent + data.lang + ')', 'k');
        data.langs.forEach(function (l) { write('  ' + pad(l.code, 8) + l.label + ' — ' + l.name); });
        return;
      }
      var hit = data.langs.filter(function (l) { return l.code === arg; })[0];
      if (!hit) { write(data.s.noLang + '"' + arg + '"', 'err'); return; }
      write(data.s.opening + hit.url + ' …');
      setTimeout(function () { location.href = hit.url; }, 220);
    },
    sudo: function () { write(data.s.sudo, 'err'); }
  };

  function run(raw) {
    var parts = raw.trim().split(/\s+/);
    var cmd = (parts.shift() || '').toLowerCase();
    var arg = (parts.shift() || '').toLowerCase();
    var el = document.createElement('span');
    el.className = 'cmd';
    el.textContent = 'javier@aberdeen ~ ❯ ' + raw + '\n';
    out.appendChild(el);
    if (!cmd) return;
    if (commands[cmd]) commands[cmd](arg);
    else write(cmd + ': command not found. Try help.', 'err');
    write('');
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var raw = input.value;
    if (raw.trim()) { history.push(raw); hpos = history.length; }
    input.value = '';
    run(raw);
    out.scrollTop = out.scrollHeight;
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowUp' && hpos > 0) { e.preventDefault(); input.value = history[--hpos]; }
    else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (hpos < history.length - 1) input.value = history[++hpos];
      else { hpos = history.length; input.value = ''; }
    } else if (e.key === 'Tab') {
      e.preventDefault();
      var typed = input.value.trim();
      var pool = typed.indexOf(' ') > -1
        ? (typed.split(/\s+/)[0] === 'skin'
            ? data.skins.map(function (x) { return 'skin ' + x.id; })
            : typed.split(/\s+/)[0] === 'lang'
            ? data.langs.map(function (l) { return 'lang ' + l.code; })
            : data.pages.map(function (x) { return 'open ' + x[0]; }))
        : Object.keys(commands);
      var hits = pool.filter(function (c) { return c.indexOf(typed) === 0; });
      if (hits.length === 1) input.value = hits[0] + ' ';
      else if (hits.length > 1) { run(typed); write(hits.join('  ')); write(''); }
    }
  });
})();
</script>

<style>
  .term-wrap{padding:44px 0 8px}
  .win{
    border:2px solid var(--accent2);border-radius:10px;overflow:hidden;
    background:color-mix(in srgb, var(--bg), #000 22%);
  }
  /* A bar in the shape of a Wayland status bar, not a macOS title bar:
     workspace pills on the left, window title in the middle, status right. */
  .bar{
    display:flex;align-items:center;gap:14px;
    padding:7px 12px;border-bottom:1px solid var(--line);
    background:var(--surface);font-family:var(--font-display);font-size:11.5px;
    color:var(--muted);letter-spacing:.04em;
  }
  .ws{display:flex;gap:6px;align-items:center}
  .ws b{background:var(--accent);color:var(--bg);padding:0 6px;border-radius:3px;font-weight:700}
  .ws i{width:6px;height:6px;border-radius:50%;border:1px solid var(--line);display:block}
  .wtitle{flex:1;text-align:center;color:var(--fg);opacity:.85;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .wstat{display:flex;align-items:center;gap:6px;white-space:nowrap}
  .wstat .dot{width:7px;height:7px;border-radius:50%;background:var(--accent2)}

  .term{padding:16px 18px 14px;font-family:'Courier Prime','Courier New',monospace}
  .out{
    margin:0;white-space:pre-wrap;word-break:break-word;
    font-size:13px;line-height:1.5;color:var(--fg);
    max-height:min(64vh,560px);overflow:auto;scrollbar-width:thin;
  }
  .out .cmd{color:var(--muted)}
  .out .cmd b{color:var(--accent);font-weight:700}
  .out .art{
    display:block;white-space:pre;font-size:min(2.5vw,17px);line-height:1;font-weight:700;
    margin:6px 0 12px;overflow-x:auto;overflow-y:hidden;color:var(--accent);
    background:linear-gradient(180deg,var(--accent) 0%,var(--accent) 34%,var(--strong) 34%,var(--strong) 67%,var(--accent2) 67%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  }
  @supports not (background-clip:text){.out .art{-webkit-text-fill-color:currentColor}}
  .out .who{color:var(--accent);font-weight:700}
  .out .k{color:var(--accent2)}
  .out .v{color:var(--fg)}
  .out .err{color:var(--muted)}
  .out .hint{display:block;margin-top:14px;color:var(--muted)}
  .out .hint b{color:var(--accent);font-weight:700}
  .out a{color:var(--accent);text-decoration:underline;text-decoration-color:var(--accent2)}

  .line{display:flex;align-items:baseline;gap:9px;margin-top:12px;border-top:1px solid var(--line);padding-top:12px}
  .line label{color:var(--muted);font-size:13px;white-space:nowrap}
  .line label b{color:var(--accent)}
  .line input{
    flex:1;min-width:0;background:none;border:0;outline:none;
    color:var(--fg);font:inherit;font-size:13px;caret-color:var(--accent);
  }
  .line input::placeholder{color:var(--muted);opacity:.7}
  .line:focus-within{border-top-color:var(--accent2)}

  @media (max-width:700px){
    .term-wrap{padding-top:28px}
    .wstat{display:none}
    .wtitle{text-align:left}
    .out{font-size:12px}
  }
</style>
