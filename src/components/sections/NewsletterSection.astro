---
// Standalone rather than a <Page>: the status and the subscribe link have to
// sit above the essays, and Page renders its `sections` before the slot.
import { pages } from '../../data/pages.mjs';
import { expand } from '../../data/routes.mjs';

const { lang = 'en' } = Astro.props;
const p = pages.newsletter[lang];
---
<section class="hero" id="newsletter">
  <p class="kicker">{p.kicker}</p>
  <h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1>
  <p class="lede">{p.lede}</p>
</section>
<section class="grid"><span class="label">{p.statusLabel}</span><div class="notice">{p.status}</div></section>
<section class="grid"><span class="label">{p.readLabel}</span><div class="rows">
  {p.rows.map((r) => (
    <a class="row" href={expand(r.href)} target="_blank" rel="noreferrer"><time>{r.time}</time><div><h3>{r.h3}</h3><p>{r.p}</p></div></a>
  ))}
</div></section>
<section class="grid"><span class="label">{p.topicsLabel}</span>
  <div class="tags">{p.topics.map((topic) => <span class="tag">{topic}</span>)}</div>
</section>
{p.sections.map((s) => (
  <section class="grid"><span class="label">{s.label}</span><div class={s.cls} set:html={expand(s.html)} /></section>
))}
