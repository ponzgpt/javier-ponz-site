---
// The order lives in src/data/site.ts. Featured projects are cards (linking to
// the live site when there is one, else the repo); `also: true` ones are a
// compact list underneath, so the best work isn't buried under the rest.
// `running` stays a separate list from `projects`
// because operating something and authoring it are different claims.
import { pages } from '../../data/pages.mjs';
import { projects, running } from '../../data/site';
import { pick } from '../../data/i18n.mjs';

const { lang = 'en' } = Astro.props;
const p = pages.projects[lang];
const runningItems = running.map((r) => pick(r, lang));
const projectItems = projects.map((r) => pick(r, lang));
const featured = projectItems.filter((r) => !r.also);
const also = projectItems.filter((r) => r.also);
---
<section class="hero" id="projects"><p class="kicker">{p.kicker}</p><h2>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h2><p class="lede">{p.lede} {p.authorship}</p></section>
<section class="grid"><span class="label">{p.projectsLabel}</span><div class="cards">
  {featured.map((r) => <a class="card" href={r.live ?? r.url} target="_blank" rel="noreferrer"><span class="card-icon" aria-hidden="true">{r.icon}</span><span class="meta">{r.status} · {r.kind}<br />{r.by}</span><h3>{r.title} ↗</h3><p>{r.description}</p></a>)}
</div></section>
<section class="grid"><span class="label">{p.alsoLabel}</span><ul class="also">
  {also.map((r) => <li><a href={r.live ?? r.url} target="_blank" rel="noreferrer">{r.title} ↗</a> <span class="meta">{r.kind} · {r.status}</span></li>)}
</ul></section>
<section class="grid"><span class="label">{p.runningLabel}</span><div class="cards">
  {runningItems.map((r) => <a class="card" href={r.url} target="_blank" rel="noreferrer"><span class="card-icon" aria-hidden="true">{r.icon}</span><span class="meta">{r.status} · {r.kind}<br />{r.by}</span><h3>{r.title} ↗</h3><p>{r.description}</p></a>)}
</div></section>
<style>
  .also { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 14px; }
  .also a { color: var(--accent2); font-family: var(--font-display); }
  @media (max-width: 720px) { .also { grid-template-columns: 1fr; } }
</style>
