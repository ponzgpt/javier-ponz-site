---
import Page from '../Page.astro';
import { pages } from '../../data/pages.mjs';
import { timeline } from '../../data/site';

const p = pages.timeline;
---
<Page p={p} id="timeline">
  <section class="grid"><span class="label">{p.label}</span><div class="rows">
    {timeline.map((i) => <article class="row"><time>{i.date}</time><div><h3>{i.title}</h3><p>{i.text}</p></div></article>)}
  </div></section>
</Page>
