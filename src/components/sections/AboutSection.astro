---
import Page from '../Page.astro';
import { pages } from '../../data/pages.mjs';
import { skillGroups, credentials } from '../../data/site';

const p = pages.about;
---
<Page p={p} id="about">
  <section class="grid"><span class="label">{p.skillsLabel}</span><div class="copy">
    {skillGroups.map((g) => <div class="skillgroup"><h3>{g.name}</h3><div class="tags">{g.items.map((i) => <span class="tag">{i}</span>)}</div></div>)}
  </div></section>
  <section class="grid"><span class="label">{p.credentialsLabel}</span><div class="rows">
    {credentials.map((c) => <article class="row"><time>{c.date}</time><div><h3>{c.title}</h3><p>{c.org}{c.org && c.status ? ' · ' : ''}{c.status}</p></div></article>)}
  </div></section>
  <section class="grid"><span class="label">{p.shortLabel}</span><div class="notice">{p.short}</div></section>
</Page>
