---
// 01 · Now: the two Hermes plugins, a stats row where every figure carries its
// source, and a typed-out, clearly labelled illustrative /sabbath session.
// The figures are derived from NOW_FACTS (pages.mjs), never typed twice.
import { pages, NOW_FACTS, PR_URL, hoursBetween } from '../../data/pages.mjs';
import { projects } from '../../data/site';
import { pick } from '../../data/i18n.mjs';
import SectionHead from '../SectionHead.astro';

const { lang = 'en' } = Astro.props;
const p = pages.now[lang];
const plugins = ['Psychopomp', 'Sabbath'].map((t) => pick(projects.find((x) => x.title === t), lang));
const { tests, prs, opened, reviewed, fixed } = NOW_FACTS;
const s = p.stats;
const replay = p.replay.map(([k, v]: string[]) => ({ cls: `r-${k}`, text: (p.replayWho[k] ?? '') + v + '\n' }));
const repo = (name: string) => `https://github.com/ponzgpt/${name}`;
---
<section class="sec" id="now" aria-labelledby="now-title">
  <div class="shell">
    <SectionHead id="now-title" p={p} />
    <div class="plugins reveal">
      {plugins.map((x) => (
        <article class="card plugin">
          <span class="meta">{x.icon} {x.kind} · {x.status}</span>
          <h3>{x.title}</h3>
          <p>{x.description}</p>
          <p class="meta by">{x.by}</p>
          <p class="links"><a href={x.url} target="_blank" rel="noreferrer">{p.repo}</a></p>
        </article>
      ))}
    </div>
    <div class="now-grid">
      <div class="reveal">
        <ul class="stats">
          <li>
            <span class="fig">{tests.psychopomp + tests.sabbath}</span><span class="what">{s.tests}</span>
            <span class="src"><a href={repo('psychopomp')} target="_blank" rel="noreferrer">{tests.psychopomp} psychopomp</a> + <a href={repo('sabbath')} target="_blank" rel="noreferrer">{tests.sabbath} sabbath</a></span>
          </li>
          <li>
            <span class="fig">{prs.length}</span><span class="what">{s.prs}</span>
            <span class="src">{s.prsSrc} {prs.map((n, i) => <>{i ? ' · ' : ''}<a href={PR_URL + n} target="_blank" rel="noreferrer">#{n}</a></>)}</span>
          </li>
          <li>
            <span class="fig">{hoursBetween(opened, reviewed)} {p.hUnit}</span><span class="what">{s.review}</span>
            <span class="src"><a href={PR_URL + prs[0]} target="_blank" rel="noreferrer">{s.reviewSrc}</a></span>
          </li>
          <li>
            <span class="fig">{hoursBetween(reviewed, fixed)} {p.hUnit}</span><span class="what">{s.fixes}</span>
            <span class="src"><a href={PR_URL + prs[0]} target="_blank" rel="noreferrer">{s.fixesSrc}</a></span>
          </li>
        </ul>
        <p class="status"><span class="dot" aria-hidden="true"></span>{p.status}</p>
      </div>

      <figure class="replay reveal">
        <div class="replay-bar"><span>{p.replayLabel}</span><button type="button" class="replay-btn" id="replayBtn" hidden>↻ {p.replayAgain}</button></div>
        <pre class="replay-out" id="replayOut">{replay.map((r) => <span class={r.cls}>{r.text}</span>)}</pre>
        <figcaption>{p.replayNote}</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  /* Typewriter for the replay. The full session is already in the HTML (so it
     reads without JS and for screen readers); this blanks it and types it back
     once it scrolls into view. Reduced motion: leave it as written. */
  (function () {
    var out = document.getElementById('replayOut');
    var btn = document.getElementById('replayBtn');
    if (!out || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    var lines = Array.prototype.map.call(out.children, function (s) { return { cls: s.className, text: s.textContent }; });
    out.setAttribute('aria-busy', 'true');
    var timer = 0;
    function play() {
      clearTimeout(timer);
      out.textContent = '';
      btn.hidden = true;
      var li = 0, ci = 0, span = null;
      (function tick() {
        if (li >= lines.length) { btn.hidden = false; out.removeAttribute('aria-busy'); return; }
        var line = lines[li];
        if (!span) { span = document.createElement('span'); span.className = line.cls; out.appendChild(span); }
        ci++;
        span.textContent = line.text.slice(0, ci);
        if (ci >= line.text.length) { li++; ci = 0; span = null; timer = setTimeout(tick, line.cls === 'r-cmd' ? 500 : 260); }
        else timer = setTimeout(tick, line.cls === 'r-bot' ? 14 : 55);
      })();
    }
    var io = new IntersectionObserver(function (e) {
      if (e[0].isIntersecting) { io.disconnect(); play(); }
    }, { threshold: 0.4 });
    io.observe(out);
    btn.addEventListener('click', play);
  })();
</script>

<style is:global>
  .now-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start;margin-top:24px}
  .plugins{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .plugin p:not(.meta):not(.links){max-width:62ch}
  .plugin p.meta{margin-top:12px}
  .stats{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid var(--line)}
  .stats li{padding:16px 14px;display:flex;flex-direction:column;gap:2px;min-width:0}
  .stats li:nth-child(even){border-left:1px solid var(--line)}
  .stats li:nth-child(n+3){border-top:1px solid var(--line)}
  .fig{font-family:var(--font-display);font-weight:800;font-size:46px;line-height:1;color:var(--accent)}
  .what{font-family:var(--font-mono);font-size:12px;color:var(--fg)}
  .src{font-family:var(--font-mono);font-size:11px;color:var(--muted);margin-top:8px;overflow-wrap:anywhere}
  .status{display:flex;gap:10px;align-items:baseline;font-family:var(--font-mono);font-size:13px;color:var(--muted);margin:16px 0 0}
  .status .dot{width:8px;height:8px;border-radius:50%;background:var(--accent2);flex:none;align-self:center}
  .replay{margin:0;border:1px solid var(--line);background:color-mix(in srgb, var(--bg), #000 30%)}
  .replay-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--line);font-family:var(--font-mono);font-size:12px;color:var(--accent2);letter-spacing:.06em}
  .replay-btn{background:none;border:1px solid var(--line);color:var(--fg);font:inherit;padding:3px 8px;cursor:pointer}
  .replay-btn:hover{border-color:var(--accent)}
  .replay-out{margin:0;padding:16px 16px 18px;min-height:17.6em;font-family:var(--font-mono);font-size:13px;line-height:1.6;white-space:pre-wrap;color:var(--fg)}
  .r-cmd{color:var(--accent)}
  .r-you{color:var(--fg)}
  .r-bot{color:color-mix(in srgb, var(--fg) 80%, var(--accent2))}
  .r-sep{color:var(--muted)}
  .replay figcaption{padding:9px 14px;border-top:1px solid var(--line);font-family:var(--font-mono);font-size:12px;color:var(--muted)}
  @media (max-width:1000px){.now-grid{grid-template-columns:1fr}}
  @media (max-width:640px){
    .plugins{grid-template-columns:1fr}
  }
</style>
