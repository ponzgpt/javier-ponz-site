---
import { pages } from '../../data/pages.mjs';
import { href } from '../../data/i18n.mjs';
import { expand } from '../../data/routes.mjs';

const { lang } = Astro.props;
const p = pages.now[lang];
const ex = (h) => expand(h, lang, href);
---
<section class="hero" id="now"><p class="kicker">{p.kicker}</p><h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1><p class="lede">{p.lede}</p></section>
{p.obsessions.map((s) => <section class="grid"><span class="label">{s.label}</span><div class="prose" set:html={ex(s.html)} /></section>)}
<section class="grid"><span class="label">{p.focusLabel}</span><div class="cards">
  {p.cards.map((c) => <article class="card"><span class="meta">{c.meta}</span><h3 set:html={c.h3} /><p>{c.p}</p></article>)}
</div></section>
<section class="grid"><span class="label">{p.studyLabel}</span><div class="copy"><h2>{p.studyH2}</h2><p>{p.study}</p></div></section>
<section class="grid"><span class="label">{p.openLabel}</span><div class="notice" set:html={ex(p.open)} /></section>
