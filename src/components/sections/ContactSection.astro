---
// The CV disclosure reuses the header's <details> pattern (Layout.astro's
// skin picker) rather than inventing a new popover component — same native
// disclosure, same .skinpicker/.skinmenu classes, just placed here instead
// of the header now that there is no standalone /cv page.
import { pages } from '../../data/pages.mjs';
import { person, profile, personEs, profileEs } from '../../data/cv.mjs';

const { lang = 'en' } = Astro.props;
const p = pages.contact[lang];
const cvLabels = pages.cv[lang];
const headline = lang === 'en' ? person.headline : personEs.headline;
const blurb = lang === 'en' ? profile[0] : profileEs[0];
---
<section class="hero" id="contact">
  <p class="kicker">{p.kicker}</p>
  <h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1>
  <p class="lede">{p.lede}</p>
</section>
<section class="grid"><span class="label">{p.coordsLabel}</span><div class="rows">
  {p.rows.map((r) => (
    <div class="row">
      <a class="row-link" href={r.href} target={r.ext ? '_blank' : null} rel={r.ext ? 'noreferrer' : null}><time>{r.time}</time><div><h3>{r.h3}</h3><p>{r.p}</p></div></a>
      <button type="button" class="copy-btn" data-copy={r.copy} data-copied-label={p.copiedLabel} data-failed-label={p.copyFailedLabel}>{p.copyLabel}</button>
    </div>
  ))}
</div></section>
<section class="grid"><span class="label">{cvLabels.kicker}</span><div class="copy">
  <details class="skinpicker cvpicker">
    <summary aria-label={cvLabels.kicker}><span class="sw"></span><span>{headline}</span><span class="chev">&#9662;</span></summary>
    <div class="skinmenu cvmenu" role="menu">
      <p class="cv-blurb">{blurb}</p>
      <a class="dl" href="/javier-ponz-prado-cv.pdf" download>{cvLabels.download}</a>
    </div>
  </details>
</div></section>
<section class="grid"><span class="label">{p.availabilityLabel}</span><div class="copy" set:html={p.availability} /></section>
<section class="grid"><span class="label">{p.finalLabel}</span><div class="notice">{p.final}</div></section>

<script is:inline>
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.copy-btn');
    if (!btn || btn.disabled) return;
    const text = btn.dataset.copy;
    const original = btn.textContent;
    const flash = function (label) {
      btn.textContent = label || original;
      btn.disabled = true;
      setTimeout(function () { btn.textContent = original; btn.disabled = false; }, 1600);
    };
    if (!navigator.clipboard) { flash(btn.dataset.failedLabel); return; }
    navigator.clipboard.writeText(text).then(function () {
      flash(btn.dataset.copiedLabel);
    }, function () {
      flash(btn.dataset.failedLabel);
    });
  });
</script>

<style>
  .cvmenu{position:static;min-width:0;width:min(420px,100%);padding:16px;gap:10px}
  .cv-blurb{margin:0;font-size:14px;color:var(--fg)}
  .dl{display:inline-block;border:2px solid var(--accent);color:var(--accent);padding:10px 18px;text-decoration:none;font-weight:700;align-self:flex-start}
  .dl:hover{background:var(--accent);color:var(--bg);text-decoration:none}
</style>
