---
// Hero plus a list of labelled sections — the shape every prose section on
// this site shares. Keeping it in one place means a section file is just
// its data lookup.
import { expand } from '../data/routes.mjs';

const { p, id } = Astro.props;
---
<section class="hero" id={id}>
  <p class="kicker">{p.kicker}</p>
  <h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1>
  <p class="lede">{p.lede}</p>
</section>
{(p.sections ?? []).map((s) => (
  <section class="grid">
    <span class="label">{s.label}</span>
    <div class={s.cls} set:html={expand(s.html)} />
  </section>
))}
<slot />
{p.related && (
  <section class="grid">
    <span class="label">{p.relatedLabel}</span>
    <div class="cards">{p.related.map((c) => (
      <a class="card" href={expand(c.href)} target={c.ext ? '_blank' : null} rel={c.ext ? 'noreferrer' : null}>
        <span class="meta">{c.meta}</span><h3>{c.h3}</h3><p>{c.p}</p>
      </a>
    ))}</div>
  </section>
)}
