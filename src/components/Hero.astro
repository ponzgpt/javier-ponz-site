---
// One screen: who he is. Prompt, giant name with a block cursor, the one line,
// link chips, and the ASCII portrait that resolves from noise on hover/focus.
// Behind it, a dithered WebGL field (src/scripts/hero-shader.ts) under drifting
// venetian-blind light. Everything here is static HTML first; the shader and
// the portrait noise are progressive enhancement.
import { pages } from '../data/pages.mjs';
import { portrait } from '../data/portrait.mjs';

const { lang = 'en' } = Astro.props;
const p = pages.home[lang];
const chips = [
  { label: 'X', href: 'https://x.com/sudotechnoir' },
  { label: 'GitHub', href: 'https://github.com/ponzgpt' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/javierponz' },
  { label: p.cv, href: '/javier-ponz-prado-cv.pdf' }
];
---
<section class="hero" aria-labelledby="hero-name">
  <div class="hero-fx" id="heroFx" aria-hidden="true"></div>
  <div class="blinds" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-text">
      <p class="prompt"><span class="who">javier@techn0ir</span>:<span class="path">~</span>$ {p.prompt}</p>
      <h1 class="name" id="hero-name">Javier Ponz<span class="name-cur" aria-hidden="true">_</span></h1>
      <p class="line">{p.line}</p>
      <ul class="chips">
        {chips.map((c) => (
          <li><a class="chip" href={c.href} target="_blank" rel="noreferrer">{c.label} <span aria-hidden="true">↗</span></a></li>
        ))}
        <li><span class="chip chip-plain">Discord: sudotechnoir</span></li>
      </ul>
    </div>
    <pre class="portrait" id="portrait" tabindex="0" role="img" aria-label={p.portraitLabel}>{portrait}</pre>
  </div>
  <a class="scroll-cue" href="#now">{p.scroll}</a>
</section>

<div class="marquee" role="presentation">
  <div class="marquee-track">
    <p class="marquee-set">{p.marquee.map((w) => <span>{w}</span>)}</p>
    <p class="marquee-set" aria-hidden="true">{p.marquee.map((w) => <span>{w}</span>)}</p>
  </div>
</div>

<script is:inline>
  /* The portrait sits dithered: a fixed random subset of its glyphs is swapped
     for noise. Hover or focus eases that subset to zero, so the face resolves;
     leaving lets it dissolve back. Only runs while easing, never idles. With
     reduced motion it jumps between the two states instead of easing. */
  (function () {
    var el = document.getElementById('portrait');
    if (!el) return;
    var clean = el.textContent;
    var RAMP = '.:-=+*#%@';
    var NOISY = 0.5;
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var seed = [];
    for (var i = 0; i < clean.length; i++) seed.push(Math.random());
    var level = NOISY, target = NOISY, raf = 0, last = 0;
    function paint() {
      var out = '';
      for (var i = 0; i < clean.length; i++) {
        var ch = clean[i];
        out += (ch !== ' ' && ch !== '\n' && seed[i] < level) ? RAMP[(Math.random() * RAMP.length) | 0] : ch;
      }
      el.textContent = out;
    }
    function step(now) {
      var dt = Math.min(0.05, (now - last) / 1000); last = now;
      var dir = target > level ? 1 : -1;
      level += dir * dt * 1.1;
      if ((dir > 0 && level >= target) || (dir < 0 && level <= target)) level = target;
      paint();
      raf = level === target ? 0 : requestAnimationFrame(step);
    }
    function go(t) {
      target = t;
      if (still) { level = t; paint(); return; }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(step); }
    }
    paint();
    el.addEventListener('pointerenter', function () { go(0); });
    el.addEventListener('pointerleave', function () { if (document.activeElement !== el) go(NOISY); });
    el.addEventListener('focus', function () { go(0); });
    el.addEventListener('blur', function () { go(NOISY); });
  })();
</script>

<script>
  import { mountHeroShader } from '../scripts/hero-shader';
  mountHeroShader(document.getElementById('heroFx'));
</script>

<style is:global>
  .hero{position:relative;isolation:isolate;min-height:calc(100svh - 58px);display:flex;flex-direction:column;justify-content:center;overflow:hidden;margin-top:-58px;padding:110px 0 70px}
  /* Static fallback under the canvas: a sodium glow and a fine ordered-dot
     raster, so no-JS and no-WebGL visitors still get the same mood. */
  .hero-fx{position:absolute;inset:0;z-index:-3;
    background:
      radial-gradient(ellipse 60% 70% at 78% 40%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 22%, transparent) 1px, transparent 1.5px) 0 0/6px 6px,
      var(--bg)}
  .hero-fx canvas{display:block;width:100%;height:100%}
  /* Scrim: keeps the text column on near-solid background over the shader. */
  .hero::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:
      linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 38%, color-mix(in srgb, var(--bg) 30%, transparent) 70%, transparent 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%)}
  /* Venetian-blind light: slanted bands of bone-coloured light drifting
     slowly across, masked so they fall off toward the edges. */
  .blinds{position:absolute;inset:-20%;z-index:-2;pointer-events:none;opacity:.55;
    background:repeating-linear-gradient(-14deg, color-mix(in srgb, var(--fg) 7%, transparent) 0 22px, transparent 22px 58px);
    -webkit-mask-image:radial-gradient(ellipse 55% 60% at 70% 45%, #000 20%, transparent 75%);
    mask-image:radial-gradient(ellipse 55% 60% at 70% 45%, #000 20%, transparent 75%);
    animation:blinds 26s linear infinite}
  @keyframes blinds{from{transform:translateX(0)}to{transform:translateX(116px)}}

  .hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:40px;align-items:center}
  .prompt{font-family:var(--font-mono);font-size:15px;color:var(--muted);margin:0 0 10px}
  .prompt .who{color:var(--accent2)}
  .prompt .path{color:var(--accent)}
  .name{font-family:var(--font-display);font-weight:800;text-transform:uppercase;font-size:clamp(68px,11.5vw,176px);line-height:.86;letter-spacing:.005em;margin:0 0 26px;color:var(--fg)}
  .name .name-cur{color:var(--accent);animation:blink 1.1s steps(1) infinite;margin-left:.03em}
  .line{font-size:clamp(18px,1.7vw,22px);line-height:1.45;max-width:34ch;margin:0 0 28px}
  .chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
  .chip{display:inline-block;font-family:var(--font-mono);font-size:13px;padding:8px 13px;border:1px solid var(--line);background:color-mix(in srgb, var(--bg) 70%, transparent);color:var(--fg);text-decoration:none}
  a.chip:hover{border-color:var(--accent);color:var(--accent);text-decoration:underline}
  .chip-plain{color:var(--muted)}
  .portrait{margin:0;justify-self:end;font-family:var(--font-mono);font-size:clamp(4px,.52vw,7.4px);line-height:1;white-space:pre;color:var(--accent);opacity:.92;cursor:crosshair;
    text-shadow:0 0 6px color-mix(in srgb, var(--accent) 45%, transparent)}
  .portrait:focus-visible{outline-offset:8px}
  .scroll-cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);font-family:var(--font-mono);font-size:12px;color:var(--muted);text-decoration:none;animation:cue 2.4s ease-in-out infinite}
  .scroll-cue:hover{color:var(--accent)}
  @keyframes cue{50%{transform:translate(-50%,5px)}}

  .marquee{overflow:hidden;border-block:1px solid var(--line);background:var(--surface);font-family:var(--font-mono);font-size:13px;letter-spacing:.18em;color:var(--muted)}
  .marquee-track{display:flex;width:max-content;animation:marquee 90s linear infinite}
  .marquee-set{display:flex;margin:0;padding:12px 0}
  .marquee-set span{padding:0 22px;white-space:nowrap}
  .marquee-set span::after{content:"◆";color:var(--accent);margin-left:44px;font-size:9px;vertical-align:2px}
  .marquee-set span{padding:0 0 0 22px}
  @keyframes marquee{to{transform:translateX(-50%)}}

  @media (max-width:900px){
    .hero{min-height:auto;padding:100px 0 64px}
    .hero-grid{grid-template-columns:1fr}
    .portrait{justify-self:start;font-size:calc((100vw - 32px) / 66)}
  }
</style>
