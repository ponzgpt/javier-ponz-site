---
// The whole one-page site, parametrised by `lang`; src/pages/index.astro and
// src/pages/es/index.astro are thin wrappers around this.
//
// Scroll order is the navigation order, and the kickers in pages.mjs number
// themselves 01…06 to match. Reorder here and there together.
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import NowSection from './sections/NowSection.astro';
import WorkSection from './sections/WorkSection.astro';
import RigSection from './sections/RigSection.astro';
import StorySection from './sections/StorySection.astro';
import NotesSection from './sections/NotesSection.astro';
import ConnectSection from './sections/ConnectSection.astro';
import { pages } from '../data/pages.mjs';

const { lang = 'en' } = Astro.props;
const p = pages.home[lang];
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <Hero lang={lang} />
  <NowSection lang={lang} />
  <WorkSection lang={lang} />
  <RigSection lang={lang} />
  <StorySection lang={lang} />
  <NotesSection lang={lang} />
  <ConnectSection lang={lang} />
</Layout>
