---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---
<Layout title="Javier Ponz — field notes">
  <section class="hero"><p class="kicker">Personal wiki · Aberdeen, Scotland</p><h1>Making technology more <span class="serif">understandable</span> and useful.</h1><p class="lede">I help people make sense of technology and agents — by touching the systems, talking to the people, and leaving the next person with more clarity than they had before.</p></section>
  <section class="grid"><span class="label">01 / Overview</span><div class="copy"><h2>A people-first technologist in transition.</h2><p>Ten years at Apple Retail Spain taught me to operate in ambiguity, handle service and operations, and connect human problems with technical systems. I am now retraining in Artificial Intelligence and Full Stack development, focusing on agents, workflows and documentation.</p><p>This site is the long-form version of a professional profile: facts, projects, interests, learning and the things I am not claiming yet.</p><div class="tags"><span class="tag">technical service</span><span class="tag">troubleshooting</span><span class="tag">AI adoption</span><span class="tag">documentation</span><span class="tag">learning in public</span></div></div></section>
  <section class="grid"><span class="label">02 / Explore</span><div class="cards"><a class="card" href="/about"><span class="meta">Background</span><h3>About & experience →</h3><p>Apple Retail, the transition to AI and the boundary between people and systems.</p></a><a class="card" href="/workbench"><span class="meta">Build log</span><h3>Workbench →</h3><p>Projects, repositories and experiments with explicit status and scope.</p></a><a class="card" href="/now"><span class="meta">Current signal</span><h3>Now →</h3><p>What has my attention, what I am learning and where the work is heading.</p></a><a class="card" href="/nous-application"><span class="meta">Open application</span><h3>Why Nous →</h3><p>A personal application to Nous Research, kept honest and separate from affiliation.</p></a></div></section>
  <section class="grid"><span class="label">03 / Selected work</span><div class="rows">{projects.slice(0,3).map((project) => <a class="row" href={project.url} target="_blank" rel="noreferrer"><time>{project.kind}</time><div><h3>{project.title} ↗</h3><p>{project.description}</p></div></a>)}</div></section>
</Layout>
