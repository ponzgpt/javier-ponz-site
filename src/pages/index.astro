---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import TimelineSection from '../components/sections/TimelineSection.astro';
import AgentsSection from '../components/sections/AgentsSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ThoughtsSection from '../components/sections/ThoughtsSection.astro';
import NowSection from '../components/sections/NowSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { pages } from '../data/pages.mjs';
import { projects } from '../data/site';
import { expand } from '../data/routes.mjs';

const p = pages.home;
const proj = projects.slice(0, 3);
---
<Layout title={p.title} description={p.desc}>
  <Terminal />
  <section class="hero"><p class="kicker">{p.kicker}</p>
    <h1 class="sr-only">Javier Ponz</h1>
    <p class="tagline">{p.tagline}<span class="serif">{p.taglineSerif}</span>{p.taglineEnd}</p>
    <p class="lede">{p.lede}</p></section>
  <section class="grid"><span class="label">{p.overviewLabel}</span><div class="copy">
    <h2>{p.overviewH2}</h2>
    <Fragment set:html={expand(p.overview)} />
    <div class="tags">{p.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
  </div></section>
  <section class="grid"><span class="label">{p.exploreLabel}</span><div class="cards">
    {p.cards.map((c) => <a class="card" href={expand(c.href)}><span class="meta">{c.meta}</span><h3>{c.h3}</h3><p>{c.p}</p></a>)}
  </div></section>
  <section class="grid"><span class="label">{p.workLabel}</span><div class="rows">
    {proj.map((r) => <a class="row" href={r.url} target="_blank" rel="noreferrer"><time>{r.kind}<br /><span class="byline">{r.by}</span></time><div><h3>{r.title} ↗</h3><p>{r.description}</p></div></a>)}
  </div></section>

  <AboutSection />
  <TimelineSection />
  <AgentsSection />
  <ProjectsSection />
  <ThoughtsSection />
  <NowSection />
  <ContactSection />
</Layout>
