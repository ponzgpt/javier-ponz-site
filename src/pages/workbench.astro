---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---
<Layout title="Workbench — Javier Ponz"><section class="hero"><p class="kicker">Workbench</p><h1>Things I am <span class="serif">making</span>.</h1><p class="lede">Small tools and workflows are how I turn curiosity into evidence. Each project has a scope, a status and a limit.</p></section><section class="grid"><span class="label">Projects</span><div class="cards">{projects.map((project)=><a class="card" href={project.url} target="_blank" rel="noreferrer"><span class="meta">{project.status} · {project.kind}</span><h3>{project.title} ↗</h3><p>{project.description}</p></a>)}</div></section><section class="grid"><span class="label">Scope note</span><div class="notice">These are personal projects and learning artefacts. They are not presented as enterprise deployments or paid client work.</div></section></Layout>
