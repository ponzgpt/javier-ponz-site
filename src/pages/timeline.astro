---
import Layout from '../layouts/Layout.astro';
import { timeline } from '../data/site';
---
<Layout title="Timeline — Javier Ponz"><section class="hero"><p class="kicker">Timeline</p><h1>A work in <span class="serif">progress</span>.</h1><p class="lede">A deliberately concise chronology. The current chapter is still being written.</p></section><section class="grid"><span class="label">Chronology</span><div class="rows">{timeline.map((item)=><article class="row"><time>{item.date}</time><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section></Layout>
