---
import Layout from '../layouts/Layout.astro';
import { person, profile, shipped, experience, education, skills } from '../data/cv.mjs';

// The PDF at /javier-ponz-prado-cv.pdf is generated from this same module by
// `npm run cv:pdf`, so the two cannot drift apart. Contact entries marked
// private (the phone number) go into the PDF only, never onto this page.
const publicContact = person.contact.filter((c) => !c.private);

// Structured data: the first reader of a CV is now often software.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'AI systems and agent operations',
  description: profile[0],
  email: 'nerion89@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Aberdeen', addressCountry: 'GB' },
  url: 'https://javierponz.technoir.cloud/',
  sameAs: ['https://github.com/ponzgpt', 'https://www.linkedin.com/in/javierponz'],
  knowsLanguage: ['es', 'en'],
  knowsAbout: skills.flatMap((s) => s.items),
  alumniOf: education.map((e) => ({ '@type': 'Organization', name: e.where })),
  worksFor: { '@type': 'Organization', name: 'Machines Do It Better' }
};
---
<Layout title="CV — Javier Ponz" description="Curriculum vitae of Javier Ponz Prado: AI systems and agent operations, technical troubleshooting, and ten years of technical service at Apple Retail.">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="hero"><p class="kicker">Curriculum vitae</p><h1>{person.name.split(' ').slice(0,2).join(' ')} <span class="serif">{person.name.split(' ')[2]}</span></h1><p class="lede">{person.headline.replace(/ · /g, ' · ')} · {person.location}.</p>
<p><a class="dl" href="/javier-ponz-prado-cv.pdf" download>↓ Download CV (PDF)</a></p>
</section>

<section class="grid"><span class="label">Profile</span><div class="prose">
{profile.map((para) => <p>{para}</p>)}
</div></section>

<section class="grid"><span class="label">Selected work</span><div class="rows">
{shipped.map((e) => <article class="row"><time>{e.when}</time><div><h3>{e.href ? <a href={e.href} target="_blank" rel="noreferrer">{e.title} ↗</a> : e.title}</h3><p class="meta-line">{e.where}</p><p>{e.body}</p></div></article>)}
</div></section>

<section class="grid"><span class="label">Experience</span><div class="rows">
{experience.map((e) => <article class="row"><time>{e.when}</time><div><h3>{e.title}</h3><p class="meta-line">{e.where}</p><p>{e.body}</p></div></article>)}
</div></section>

<section class="grid"><span class="label">Education</span><div class="rows">
{education.map((e) => <article class="row"><time>{e.when}</time><div><h3>{e.title}</h3><p class="meta-line">{e.where}</p></div></article>)}
</div></section>

<section class="grid"><span class="label">Skills</span><div class="copy">
{skills.map((s) => <div class="skillgroup"><h3>{s.group}</h3><div class="tags">{s.items.map((i) => <span class="tag">{i}</span>)}</div></div>)}
</div></section>

<section class="grid"><span class="label">Contact</span><div class="rows">
{publicContact.map((c) => <a class="row" href={c.href} target={c.href.startsWith('http') ? '_blank' : null} rel="noreferrer"><time>{c.label}</time><div><h3>{c.value}</h3></div></a>)}
</div></section>

<section class="grid"><span class="label">More</span><div class="copy"><p>A shorter chronology is on the <a href="/timeline">timeline</a>. The PDF above is generated from the same source as this page, so the two never disagree.</p></div></section>
</Layout>

<style>
  .dl{display:inline-block;border:2px solid var(--gold);color:var(--gold);padding:10px 18px;text-decoration:none;font-weight:700;margin-top:6px}
  .dl:hover{background:var(--gold);color:var(--paper);text-decoration:none}
  .meta-line{font-size:13px;color:var(--muted);margin:0 0 8px}
</style>
