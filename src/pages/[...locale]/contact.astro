---
import Layout from '../../layouts/Layout.astro';
import { pages } from '../../data/pages.mjs';
import { localePaths } from '../../data/routes.mjs';
export const getStaticPaths = localePaths;
const lang = Astro.params.locale ?? 'en';
const p = pages.contact[lang];
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <section class="hero"><p class="kicker">{p.kicker}</p><h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1><p class="lede">{p.lede}</p></section>
  <section class="grid"><span class="label">{p.coordsLabel}</span><div class="rows">
    {p.rows.map((r) => (
      <div class="row">
        <a class="row-link" href={r.href} target={r.ext ? '_blank' : null} rel={r.ext ? 'noreferrer' : null}><time>{r.time}</time><div><h3>{r.h3}</h3><p>{r.p}</p></div></a>
        <button type="button" class="copy-btn" data-copy={r.copy} data-copied-label={p.copiedLabel} data-failed-label={p.copyFailedLabel}>{p.copyLabel}</button>
      </div>
    ))}
  </div></section>
  <script is:inline>
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.copy-btn');
      if (!btn || btn.disabled) return;
      const text = btn.dataset.copy;
      const original = btn.textContent;
      const flash = function (label) {
        btn.textContent = label || original;
        btn.disabled = true;
        setTimeout(function () { btn.textContent = original; btn.disabled = false; }, 1600);
      };
      if (!navigator.clipboard) { flash(btn.dataset.failedLabel); return; }
      navigator.clipboard.writeText(text).then(function () {
        flash(btn.dataset.copiedLabel);
      }, function () {
        flash(btn.dataset.failedLabel);
      });
    });
  </script>
</Layout>
