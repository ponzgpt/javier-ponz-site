---
import Layout from '../../layouts/Layout.astro';
import { pages } from '../../data/pages.mjs';
import { localePaths } from '../../data/routes.mjs';
export const getStaticPaths = localePaths;
const lang = Astro.params.locale ?? 'en';
const p = pages.memento[lang];
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <section class="hero"><p class="kicker">{p.kicker}</p><h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1><p class="lede">{p.lede}</p></section>
  <section class="grid"><span class="label">{p.appLabel}</span><div class="copy">
    <figure class="shot"><a href="https://memento.technoir.cloud/" target="_blank" rel="noreferrer"><img src="/shots/memento-mori.jpg" alt="Memento Mori" width="1200" height="833" loading="lazy" /></a><figcaption>{p.caption}</figcaption></figure>
  </div></section>
  <section class="grid"><span class="label">{p.linksLabel}</span><div class="rows">
    {p.links.map((l) => <a class="row" href={l.href} target="_blank" rel="noreferrer"><time>{l.time}</time><div><h3>{l.h3}</h3><p>{l.p}</p></div></a>)}
  </div></section>
  {p.sections.map((s) => <section class="grid"><span class="label">{s.label}</span><div class={s.cls} set:html={s.html} /></section>)}
  <section class="grid"><span class="label">{p.scopeLabel}</span><div class="notice">{p.scope}</div></section>
</Layout>
