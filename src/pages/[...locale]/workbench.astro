---
import Layout from '../../layouts/Layout.astro';
import { pages } from '../../data/pages.mjs';
import { projects, running } from '../../data/site';
import { localePaths, expand } from '../../data/routes.mjs';
import { pick, href } from '../../data/i18n.mjs';
export const getStaticPaths = localePaths;
const lang = Astro.params.locale ?? 'en';
const p = pages.workbench[lang];
const run = running.map((r) => pick(r, lang));
const proj = projects.map((r) => pick(r, lang));
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <section class="hero"><p class="kicker">{p.kicker}</p><h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1><p class="lede">{p.lede}</p></section>
  <section class="grid"><span class="label">{p.runningLabel}</span><div class="cards">
    {run.map((r) => <a class="card" href={r.url} target="_blank" rel="noreferrer"><span class="meta">{r.status} · {r.kind}<br />{r.by}</span><h3>{r.title} ↗</h3><p>{r.description}</p></a>)}
  </div></section>
  <section class="grid"><span class="label">{p.projectsLabel}</span><div class="cards">
    {proj.map((r) => <a class="card" href={r.url} target="_blank" rel="noreferrer"><span class="meta">{r.status} · {r.kind}<br />{r.by}</span><h3>{r.title} ↗</h3><p>{r.description}</p></a>)}
  </div></section>
  <section class="grid"><span class="label">{p.productionLabel}</span><div class="copy">
    <figure class="shot"><a href="https://memento.technoir.cloud/" target="_blank" rel="noreferrer"><img src="/shots/memento-mori.jpg" alt="Memento Mori" width="1200" height="833" loading="lazy" /></a><figcaption>{p.cap1}</figcaption></figure>
    <figure class="shot"><a href="https://github.com/ponzgpt/hermes-agent-site" target="_blank" rel="noreferrer"><img src="/shots/hermes-agent-site.jpg" alt="Hermes Agent Site" width="1200" height="833" loading="lazy" /></a><figcaption>{p.cap2}</figcaption></figure>
  </div></section>
  <section class="grid"><span class="label">{p.deepLabel}</span><div class="copy"><h2>{p.deepH2}</h2><p set:html={expand(p.deep, lang, href)} /></div></section>
  <section class="grid"><span class="label">{p.scopeLabel}</span><div class="notice">{p.scope}</div></section>
</Layout>
