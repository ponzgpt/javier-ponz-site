---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import { pages } from '../../data/pages.mjs';
import { skillsFor, credentials } from '../../data/site';
import { localePaths } from '../../data/routes.mjs';
import { pick } from '../../data/i18n.mjs';
export const getStaticPaths = localePaths;
const lang = Astro.params.locale ?? 'en';
const p = pages.about[lang];
const groups = skillsFor(lang);
const creds = credentials.map((c) => pick(c, lang));
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <Page p={p} lang={lang}>
    <section class="grid"><span class="label">{p.skillsLabel}</span><div class="copy">
      {groups.map((g) => <div class="skillgroup"><h3>{g.group}</h3><div class="tags">{g.items.map((i) => <span class="tag">{i}</span>)}</div></div>)}
    </div></section>
    <section class="grid"><span class="label">{p.credentialsLabel}</span><div class="rows">
      {creds.map((c) => <article class="row"><time>{c.date}</time><div><h3>{c.title}</h3><p>{c.org}{c.org && c.status ? ' · ' : ''}{c.status}</p></div></article>)}
    </div></section>
    <section class="grid"><span class="label">{p.shortLabel}</span><div class="notice">{p.short}</div></section>
  </Page>
</Layout>
