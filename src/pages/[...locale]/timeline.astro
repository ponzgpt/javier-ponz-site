---
import Layout from '../../layouts/Layout.astro';
import { pages } from '../../data/pages.mjs';
import { timeline } from '../../data/site';
import { localePaths } from '../../data/routes.mjs';
import { pick } from '../../data/i18n.mjs';
export const getStaticPaths = localePaths;
const lang = Astro.params.locale ?? 'en';
const p = pages.timeline[lang];
const items = timeline.map((i) => pick(i, lang));
---
<Layout title={p.title} description={p.desc} lang={lang}>
  <section class="hero"><p class="kicker">{p.kicker}</p><h1>{p.h1}<span class="serif">{p.serif}</span>{p.h1end}</h1><p class="lede">{p.lede}</p></section>
  <section class="grid"><span class="label">{p.label}</span><div class="rows">
    {items.map((i) => <article class="row"><time>{i.date}</time><div><h3>{i.title}</h3><p>{i.text}</p></div></article>)}
  </div></section>
</Layout>
